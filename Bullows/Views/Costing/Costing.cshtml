        // Initial event binding
        function bindEvents() {
            $('#txtEnquiryID').on('keyup', function () {
                var enquiryCode = $(this).val().trim().toLowerCase(); // Trim and convert to lowercase
                if (enquiryCode.length > 0) {
                    $.ajax({
                        url: '@Url.Action("SearchEnquiryCode", "Costing")',
                        type: 'POST',
                        data: { enquiryCode: enquiryCode },
                        success: function (data) {
                            $('#resultsContainer').empty(); // Clear previous results

                            if (data.success && data.results.length > 0) {
                                var resultsHtml = '';
                                data.results.forEach(function (item) {
                                    resultsHtml += '<div>' + item + '</div>';
                                });
                                $('#resultsContainer').html(resultsHtml).show(); // Show container with results
                            } else {
                                $('#resultsContainer').html('<div>Enquiry Code does not Available</div>').show(); // Show 'not available' message
                            }
                        },
                        error: function () {
                            $('#resultsContainer').html('<div>Error occurred while searching.</div>').show(); // Show error message
                        }
                    });
                } else {
                    $('#resultsContainer').empty().hide(); // Hide container if input is empty
                }
            });

            $(document).on('click', '#resultsContainer div', function () {
                var selectedCode = $(this).text();
                $('#txtEnquiryID').val(selectedCode);
                $('#resultsContainer').empty().hide(); // Hide container after selection
            });

            $(document).on('click', '#btnNext', function () {
                window.location.href = '@Url.Action("BOCalculations", "Costing")';
            });
        }

        bindEvents();
    });
</script>
