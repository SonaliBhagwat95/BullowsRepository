@model Bullows.Model.CostingModel
@{
    ViewData["Title"] = "Costing";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}

<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }  
    .row-spacing {
        margin-bottom: 50px; 
    }

    #resultsContainer {
        max-height: 150px; 
        overflow-y: auto;
        border: 1px solid #ccc;
        background-color: #f9f9f9;
        padding: 5px;
        margin-top: 5px;
    }

        #resultsContainer div {
            padding: 5px;
            cursor: pointer;
        }

            #resultsContainer div:hover {
                background-color: #eaeaea;
            }
</style>
