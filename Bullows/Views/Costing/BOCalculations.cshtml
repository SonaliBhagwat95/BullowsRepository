@model Bullows.Model.BOCalculationModel
@{
    ViewData["Title"] = "BOCalculations";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}
<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }

    .compact-table th, .compact-table td {
        padding: 5px;
        text-align: center;
    }

    .compact-table input.form-control {
        font-size: 12px;
        padding: 2px;
        text-align: center;
    }

    .table-responsive {
        padding: 0;
        margin: 0;
    }

    .container {
        max-width: 1200px;
        padding: 0;
        text-align: left;
        margin-left: 5px;
    }
/* 
    .table-sm th, .table-sm td {
        padding: 0.3rem;
    }
 */
 .table-md th, .table-md td {
    padding: 0.55rem 0.75rem; /* Medium padding */
    font-size: 0.9rem;        /* Slightly smaller text */
}
    .heading {
        background-color: lightslategray;
        color: white;
        padding: 10px;
        cursor: pointer;
        border-radius: 5px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .arrow {
        font-size: 16px;
        transition: transform 0.3s ease;
    }

    .grid {
        display: none; /* Initially hide the grid */
        margin-top: 10px;
        padding: 10px;
        border: 1px solid #ddd;
    }

    .heading.active .arrow {
        transform: rotate(180deg); /* Rotate arrow for expanded state */
    }
</style>
@*  BoughtOutCalculations *@
<div class="row">
    <h6> BO Calculations</h6>
<div class="col-md-3 ">
    <label class="smaller-font">Enquiry Code</label>

        <input type="text" asp-for="EnquiryCode" id="txtEnquiryCode" class="form-control smaller-font smaller-height" style="width:120px;" />
   
</div>
    <div class="col-md-2" style="padding-top:15px;">
        <button type="button" id="searchbtn" class="btn btn-primary rounded-pill" style="width:100px;">Search</button>
    </div>
</div>

<div id="BOCalculationsForm">


<div class="container" style="margin-top:15px;">

    <h6 id="BoughtOutCalculations" style="cursor:pointer;" class="heading">Bought Out Calculations   <span id="arrowIcon" class="arrow">▼</span></h6>
    <div id="BaughtOutGrid" class="table-responsive grid" style="width:100%; max-height:500px;display:none;">
        <table id="filteredTable" class="table table-md table-bordered compact-table" style="width:100%;">
            <thead class="webgrid-header" style="background-color:grey; font-size:12px;">
                <tr>
                    <th style="padding:10px;">Sr.No.</th>
                    @*  <th id="tableId" style="display:none;">MOCID</th> *@
                    <th style="padding:10px;">Item</th>
                    <th style="padding:10px;">Lux Level</th>
                    <th style="padding:10px;">Lumens</th>
                    <th style="padding:10px;">Rate</th>
                    <th style="padding:10px;">Quantity</th>
                    <th style="padding:10px;">Cost</th>
                </tr>
            </thead>
            <tbody style="font-size:12px;">
                @if (Model.TubeLightDetails == null)
                {
                    <tr><td colspan="6" style="padding:5px;">No Data Available</td></tr>
                }
                else
                {
                    int i = 0;
                    foreach (var item in Model.TubeLightDetails)
                    {
                        i++;
                        <tr>
                            <td style="padding:10px;">@i</td>
                            <td style="padding:10px;">
                                @item.LightTypes (@item.LightSubTypes)
                            </td>
                            <td style="padding:10px;">
                                <input type="text" id="txtLuxLevel_@i" class="form-control smaller-font smaller-height width-input"
                                       style="width:80px; height:25px;"
                                       name="width[@i]"
                                       value="@item.LuxLevel"
                                       data-index="@i" />
                            </td>


                            <td style="padding:10px;">
                                <input type="text" id="txtLumens_@i" class="form-control smaller-font smaller-height height-input"
                                       style="width:80px; height:25px;"
                                       name="height[@i]"
                                       value="@item.Lumens"
                                       data-index="@i" />
                            </td>

                            <!-- Rate TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtLightRate_@i"
                                       class="form-control smaller-font smaller-height rate-input"
                                       style="width:80px; height:25px;" />
                            </td>

                            <!-- Quantity TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtLightQuantity_@i"
                                       class="form-control smaller-font smaller-height quantity-input"
                                       style="width:80px; height:25px;"
                                       value="@item.Quantity" />
                            </td>

                            <!-- Cost TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtLightCost_@i"
                                       class="form-control smaller-font smaller-height cost-input"
                                       style="width:80px; height:25px;"
                                       value="0"
                                       readonly />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@* exhaustSystemHeading *@
<div class="container" style="margin-top:15px; text-align:left;">
    <h6 id="exhaustSystemHeading" style="cursor:pointer;" class="heading">Exhaust System <span id="arrowIcon" class="arrow">▼</span></h6>
    <div id="exhaustSystemGrid" class="table-responsive grid" style="width:100%; max-height:300px; display:none;">
        <table id="exhaustSystemTable" class="table table-sm table-bordered compact-table" style="width:100%;">
            <thead class="webgrid-header" style="background-color:grey; font-size:12px;">
                <tr>
                    <th style="padding:5px;">Sr.No.</th>
                    <th style="padding:5px;">Item</th>
                    <th style="padding:5px;">Capacity(m/Hr)</th>
                    <th style="padding:5px;">Rate</th>
                    <th style="padding:5px;">Quantity</th>
                    <th style="padding:5px;">Cost</th>
                </tr>
            </thead>
            <tbody style="font-size:12px;">
                @if (Model.PaintBooth == null || !Model.PaintBooth.Any())
                {
                    <tr>
                        <td colspan="6" style="padding:5px;">No Data Available</td>
                    </tr>
                }
                else
                {
                    int i = 0;

                    foreach (var item in Model.PaintBooth)
                    {
                        i++;
                        double Rounding = item.CapacityofBlowerRoundOf;
                        if (item.CapacityofBlowerRoundOf == 0)
                            Rounding = item.CapacityofBlowerinH;
                        // 1st Row: Centrifugal Blower
                        <tr>
                            <td style="padding:10px;">@i</td>
                            <td style="padding:10px;">Centrifugal Blower</td>

                            <!-- Capacity TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtCapacityOfBlower_@i"
                                       class="form-control smaller-font smaller-height width-input"
                                       style="width:80px; height:25px;"
                                       name="capacity[@i]"
                                       value="@Rounding"
                                       data-index="@i" />
                            </td>

                            <!-- Rate TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtBlowerRate_@i"
                                       class="form-control smaller-font smaller-height rate-input"
                                       style="width:80px; height:25px;" />
                            </td>

                            <!-- Quantity TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtBlowerQuantity_@i"
                                       class="form-control smaller-font smaller-height quantity-input"
                                       style="width:80px; height:25px;"
                                       value="1" />
                            </td>

                            <!-- Cost TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtBlowerCost_@i"
                                       class="form-control smaller-font smaller-height cost-input"
                                       style="width:80px; height:25px;"
                                       value="0"
                                       readonly />
                            </td>
                        </tr>

                        // 2nd Row: Electric Motor - NFLP/FLP
                        i++; // Increment for the second row
                        <tr>
                            <td style="padding:10px;">@i</td>
                            <td style="padding:10px;">Electric Motor - NLP/FLP</td>

                            <!-- Capacity (RatedOutputHP) TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtElectricMotorCapacity_@i"
                                       class="form-control smaller-font smaller-height width-input"
                                       style="width:80px; height:25px;"
                                       name="capacity[@i]"
                                       value="@item.RatedOutputHP"
                                       data-index="@i" readonly />
                            </td>

                            <!-- Rate TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtElectricMotorRate_@i"
                                       class="form-control smaller-font smaller-height rate-input"
                                       style="width:80px; height:25px;" />
                            </td>

                            <!-- Quantity TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtElectricMotorQuantity_@i"
                                       class="form-control smaller-font smaller-height quantity-input"
                                       style="width:80px; height:25px;"
                                       value="1" />
                            </td>

                            <!-- Cost TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtElectricMotorCost_@i"
                                       class="form-control smaller-font smaller-height cost-input"
                                       style="width:80px; height:25px;"
                                       value="0"
                                       readonly />
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>
