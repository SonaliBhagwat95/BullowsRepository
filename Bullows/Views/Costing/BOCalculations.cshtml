@* Paint arrested filter *@
<div class="container" style="margin-top:15px; text-align:left;">
    <h6 id="Paintarrestedfilter" style="cursor:pointer;" class="heading">Paint arrested filter <span id="arrowIcon" class="arrow">▼</span></h6>
    <div id="PaintarrestedfilterGrid" class="table-responsive grid" style="width:100%; max-height:300px; display:none;">
        <table id="PaintarrestedfilterTable" class="table table-sm table-bordered compact-table" style="width:100%;">
            <thead class="webgrid-header" style="background-color:grey; font-size:12px;">

                <tr>
                    <th style="padding:10px;">Sr.No.</th>
                    <th style="padding:10px;">Item</th>
                    <th style="padding:10px;">Width</th>
                    <th style="padding:10px;">Height</th>
                    <th style="padding:10px;">Rate</th>
                    <th style="padding:10px;">Weight</th>
                    <th style="padding:10px;">Quantity</th>
                    <th style="padding:10px;">Cost</th>
                </tr>

            </thead>
            <tbody style="font-size:12px;">


                @if (Model.FrameDetails == null)
                {
                    <tr><td colspan="6" style="padding:5px;">No Data Available</td></tr>
                }
                else
                {
                    int i = 0;
                    foreach (var item in Model.FrameDetails)
                    {
                        i++;
                        <tr>
                            <td style="padding:10px;">@i</td>
                            <td class="rate" style="padding:5px;">Paint arrested filter</td>
                            <!-- Width TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtWidth_@i" class="form-control smaller-font smaller-height width-input"
                                       style="width:80px; height:25px;"
                                       name="width[@i]"
                                       value="@item.Width"
                                       data-index="@i" />
                            </td>

                            <!-- Height TextBox -->
                            <td style="padding:10px;">
                                <input type="text" id="txtHeight_@i" class="form-control smaller-font smaller-height height-input"
                                       style="width:80px; height:25px;"
                                       name="height[@i]"
                                       value="@item.Height"
                                       data-index="@i" />
                            </td>

                            @*   <td class="rate" style="padding:5px;">@item.Rate</td> *@
                            <td style="padding:10px;">
                                <input type="text" id="txtRate_@i" class="form-control smaller-font smaller-height rate-input" style="width:80px; height:25px;" name="rate[@i]" value="@item.Rate" data-index="@i" />
                            </td>
                            <td style="padding:10px;">
                                <input type="text" id="txtWeight_@i" class="form-control smaller-font smaller-height weight-input" style="width:80px; height:25px;" name="weight[@i]" value="@item.filterWeight" data-index="@i" />
                            </td>
                            <td style="padding:10px;">
                                <input type="text" id="txtQuantity_@i" class="form-control smaller-font smaller-height quantity-input" style="width:80px; height:25px;" name="quantity[@i]" value="@item.Quantity" data-index="@i" />
                            </td>
                            <td style="padding:10px;">
                                <input type="text" id="txtCost_@i" class="form-control smaller-font smaller-height cost-input" style="width:80px; height:25px;" name="cost[@i]" value="@item.Cost" readonly />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>



<div class="container" style="margin-top:15px; text-align:left;">
    <form asp-action="savePriceDetails" asp-controller="Costing" method="post">
        <div class="row">
                <!-- Hidden field for EnquiryCode -->
                <input type="hidden" asp-for="EnquiryCode" id="hiddenEnquiryCode" />
        <div class="col-md-4">
            <label for="totalPriceOfFrame">Total Cost of Panels</label>
                    @Html.TextBoxFor(m => m.TotalPriceOfPanels, new { @class= "form-control smaller-font smaller-height", @id = "totalPriceOfPanels", style = "width:150px;" })
        </div>
        <div class="col-md-4">
            <label for="totalPriceOfFrame">Total Cost of Frame</label>
                    @Html.TextBoxFor(m => m.TotalPriceOfFrame, new { @class = "form-control smaller-font smaller-height", @id = "totalPriceOfFrame", style = "width:150px;" })
        </div>
       
    </div>
    <br/>
    <div class="row">
        <div class="col-md-4">
                <label for="totalPriceOfFrame">Cost of Raw Materials</label>
                    @Html.TextBoxFor(m => m.RowMaterials, new { @class = "form-control smaller-font smaller-height", @id = "totalPriceOfRM", style = "width:150px;" })
        </div>
        <div class="col-md-4">
                <label for="totalPriceOfFrame">Cost of Bought Out</label>
                    @Html.TextBoxFor(m => m.BoughtOut, new { @class = "form-control smaller-font smaller-height", @id = "totalPriceOfBO", style = "width:150px;" })
        </div>
           
    </div>
    <div class="row">
            <div class="col-md-4">
                <div class="form-check mt-3">
                    @Html.CheckBoxFor(m => m.IsPriceBidApproved, new { @id = "approvePriceBid", @class = "form-check-input" })
                    <label class="form-check-label" for="approvePriceBid">Approve Price Bid</label>
                </div>
            </div>
            <div class="col-md-4" style="margin-top:10px;">
                <button type="submit" class="btn btn-success rounded-pill" id="saveButton" style="width:100px">Save</button>
            </div>

    </div>
    </form>
</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
        $(document).on('click', '#searchbtn', function () {
        // Get values from the textboxes
        var enquiryCode = $('#txtEnquiryCode').val();

        // Redirect with query string parameters
        window.location.href = '@Url.Action("BOCalculations", "Costing")' +
            '?enquiryCode=' + encodeURIComponent(enquiryCode);
    });
            // Attach event listeners to Rate and Quantity inputs
            $('#BaughtOutGrid, #exhaustSystemGrid').find('.rate-input, .quantity-input').on('input', function () {
                // Find the closest row to the changed input
                var $row = $(this).closest('tr');

                // Get the Rate and Quantity input fields in the same row
                var $rateInput = $row.find('.rate-input');
                var $quantityInput = $row.find('.quantity-input');
                var $costInput = $row.find('.cost-input');

                // Parse the Rate and Quantity values
                var rate = parseFloat($rateInput.val()) || 0;
                var quantity = parseFloat($quantityInput.val()) || 0;

                // Calculate Cost
                var cost = (rate * quantity).toFixed(2);

                // Update the Cost input field
                $costInput.val(cost);
                calculateTotalPrice();
            });
        // Function to calculate the total price from both grids
        function calculateTotalPrice() {
            var totalPrice = 0;

            // Iterate over all cost-input fields in both grids
            $('#BaughtOutGrid, #exhaustSystemGrid').find('.cost-input').each(function () {
                var cost = parseFloat($(this).val()) || 0;
                totalPrice += cost;
            });

            // Update the total price textbox
            $('#totalPriceOfBO').val(totalPrice.toFixed(2));
        }

        // Attach event listeners to Rate and Quantity inputs
        $('#exhaustDuctGrid, #PaintarrestedfilterGrid, #MetalBaffelGrid').find('.rate-input, .weight-input').on('input', function () {
            // Find the closest row to the changed input
            var $row = $(this).closest('tr');

            // Get the Rate and Quantity input fields in the same row
            var $rateInput = $row.find('.rate-input');
            var $quantityInput = $row.find('.weight-input');
            var $costInput = $row.find('.cost-input');

            // Parse the Rate and Quantity values
            var rate = parseFloat($rateInput.val()) || 0;
            var quantity = parseFloat($quantityInput.val()) || 0;

            // Calculate Cost
            var cost = (rate * quantity).toFixed(2);

            // Update the Cost input field
            $costInput.val(cost);
            calculateTotalCostForDucts();
        });

        // Function to calculate the total cost for exhaust duct grids
        function calculateTotalCostForDucts() {
            var totalDuctCost = 0;

            // Iterate over all cost-input fields in these grids
            $('#exhaustDuctGrid, #PaintarrestedfilterGrid, #MetalBaffelGrid').find('.cost-input').each(function () {
                var cost = parseFloat($(this).val()) || 0;
                totalDuctCost += cost;
            });

            // Update the total cost textbox
            $('#totalPriceOfRM').val(totalDuctCost.toFixed(2));
        }

        $('#exhaustSystemHeading').on('click', function () {
            $('#exhaustSystemGrid').toggle(); // Toggle visibility of the grid
        });
        $('#exhaustduct').on('click', function () {
            $('#exhaustDuctGrid').toggle(); // Toggle visibility of the grid
        });
        $('#ScaffoldingFor').on('click', function () {
            $('#ScaffoldingForGrid').toggle(); // Toggle visibility of the grid
        });
        $('#exhaustductingstiffener').on('click', function () {
            $('#exhaustductingstiffenerGrid').toggle(); // Toggle visibility of the grid
        });
        $('#BoughtOutCalculations').on('click', function () {
            $('#BaughtOutGrid').toggle();
            $(this).toggleClass('active');
            // Toggle visibility of the grid
        });
        $('.quantity-input').on('input', function () {
            var index = $(this).data('index');
            var rate = parseFloat($('#exhaustSystemTable tr').eq(index).find('.rate').text());
            var quantity = parseFloat($(this).val());
            var costField = $('#txtCost_Exhaust_' + index);

            if (!isNaN(rate) && !isNaN(quantity)) {
                costField.val((rate * quantity).toFixed(2));
            } else {
                costField.val('');
            }
        });
        $('#exhaustPlanumDuct').on('click', function () {
            $('#exhaustPlanumDuctGrid').toggle(); // Toggle visibility of the grid
        });
        $('#WetScrubberStructure').on('click', function () {
            $('#WetScrubberStructureGrid').toggle(); // Toggle visibility of the grid
        });
        $('#TransformationDuct').on('click', function () {
            $('#TransformationDuctGrid').toggle(); // Toggle visibility of the grid
        });
        $('#Paintarrestedfilter').on('click', function () {
            $('#PaintarrestedfilterGrid').toggle(); // Toggle visibility of the grid
        });
        $('#MetalBaffel').on('click', function () {
            $('#MetalBaffelGrid').toggle(); // Toggle visibility of the grid
        });
        $('#CeilingFiltersFrame').on('click', function () {
            $('#CeilingFiltersFrameGrid').toggle(); // Toggle visibility of the grid
        });
        $('#BlowerRestingStructure').on('click', function () {
            $('#BlowerRestingStructureGrid').toggle(); // Toggle visibility of the grid
        });
        function calculateCost(row) {
            var rate = parseFloat(row.find('.txtRate').val()) || 0;
            var quantity = parseFloat(row.find('.txtQuantity').val()) || 0;
            var cost = rate * quantity;
            row.find('.txtCost').val(cost.toFixed(2));
        }
        $('#exhaustSystemTable tbody').on('input', '.txtRate, .txtQuantity', function () {
            var row = $(this).closest('tr');
            calculateCost(row);
        });
        function calculateTotalWeight() {
            $('.txtSetDuct').each(function () {
                var $row = $(this).closest('tr');
                var setDuct = parseFloat($(this).val()) || 0; // Get the value of txtSetDuct
                var weightDuct = parseFloat($row.find('.txtWeightDuct').val()) || 0; // Get the value of txtWeightDuct
                var totalWeight = setDuct * weightDuct; // Calculate the total weight
                $row.find('.txtTotalWeightDuct').val(totalWeight.toFixed(2)); // Set the value of txtTotalWeightDuct
                var cost = totalWeight * weightDuct; // Calculate the cost as totalWeight * weightDuct
                $row.find('.txtCostDuct').val(cost.toFixed(2)); // Set the value of txtCostDuct
            });
        }
        $('.txtSetDuct, .txtWeightDuct,.txtCostDuct').on('input', function () {
            calculateTotalWeight();
        });
        

  

</script>
<script>
    const checkbox = document.getElementById("approvePriceBid");
    const saveButton = document.getElementById("saveButton");

    checkbox.addEventListener("change", function () {
        if (this.checked) {
            const userConfirmed = confirm("Do you want to approve this Price Bid?");
            if (userConfirmed) {
                saveButton.disabled = false; // Enable the button if user confirms
            } else {
                this.checked = false; // Uncheck the checkbox if user cancels
                saveButton.disabled = true; // Keep the button disabled
            }
        } else {
            saveButton.disabled = true; // Disable the button if unchecked
        }
    });
</script>


