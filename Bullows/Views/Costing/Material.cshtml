@model Bullows.Model.MaterialModel
@{
    ViewData["Title"] = "Material";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<table id="productTable" ;style="border-collapse: collapse; width: 30%; border: 1px solid #ccc;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th style="border: 1px solid #ccc; padding: 8px;display:none;" id="tableId">MOCID</th>
            <th style="border: 1px solid #ccc; padding: 8px;">MOC</th>
            <th style="border: 1px solid #ccc; padding: 8px;">Density</th>
            <th style="border: 1px solid #ccc; padding: 8px;">Rate</th>
            <th style="border: 1px solid #ccc; padding: 8px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.getmaterial== null)
        {
            <tr><td colspan="9">No data available</td></tr>
        }
        else
        {
            
            @foreach (var product in ViewBag.getmaterial)
            {
               
                <tr style="border: 1px solid #ccc;">
                   
                    <td style="border: 1px solid #ccc; padding: 8px; display:none;">@product.MOCID</td>
                    <td style="border: 1px solid #ccc; padding: 8px;">@product.MOC</td>
                    <td style="border: 1px solid #ccc; padding: 8px;">@product.Density</td>
                    <td style="border: 1px solid #ccc; padding: 8px;">@product.Rate</td>
                    <td>
                        <a href="@Url.Action("Material", "Costing", new { id = product.MOCID})">
                            <img style="height:20px;width:20px" src="~/img/pencil.jpg" title="Edit" />
                        </a>
                        <a href="@Url.Action("Delete", "Costing", new { id = product.MOCID })">
                            <img style="height:20px;width:20px" src="~/img/delete.png" title="Delete" />
                        </a>
                    </td>
                </tr>
            }
        }
        
    </tbody>
</table>
<form asp-action="saveMaterials" asp-asp-controller="Costing" method="post">
    <div class="add-product-form">
        <div class="row">
            @Html.HiddenFor(c => c.MOCID)
            <div class="col-md-2">
                <label for="MOC">MOC:</label>
                @Html.TextBoxFor(c => c.MOC, new {@id="txtMOC", @class = "form-control smaller-font smaller-height", style = "width: 130px;"})
            </div>

            <div class="col-md-2">
                <label for="Density">Density:</label>
                @Html.TextBoxFor(c => c.Density, new {@id="txtDensity", @class = "form-control smaller-font smaller-height", style = "width: 130px;"})
            </div>
            <div class="col-md-2">
                <label for="Rate">Rate:</label>
                @Html.TextBoxFor(c => c.Rate, new {@id="txtRate", @class = "form-control smaller-font smaller-height", style = "width: 130px;"})
            </div>
        </div>
        <button id="addMaterialButton" type="submit" class="btn btn-primary rounded-pill">Add Material</button>
    </div>

</form>

<style>
   
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }
    .product-table-container {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 5px;
       
    }

    .product-table {
        width: 100%;
        border-collapse: collapse;
    }

        .product-table th, .product-table td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

    .add-product-form {
        margin-top: 20px;
    }

        .add-product-form label {
            display: block;
            margin-bottom: 5px;
        }

        .add-product-form input[type="text"],
        .add-product-form input[type="number"],
        .add-product-form button {
            margin-bottom: 10px;
        }
</style>



