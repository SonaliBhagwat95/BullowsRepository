                                Water Hydrant line upto booth customer scope.
                            </td>
                        </tr>
                    </tbody>
                </table>
                
            </div>

            <div class="section">
                <h4>General Specification of Control Panel</h4>

                <table>
                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Description</th>
                            <th>Type/Status</th>
                        </tr>
                    </thead>
