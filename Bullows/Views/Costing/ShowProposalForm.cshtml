                                    </label>
                                </div>
                            </td> <!-- Variable for Extraction Chamber -->
                        </tr>
                        <tr>
                            <td>13</td>
                            <td>VOC Monitoring units </td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="MonitoringUnits" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="MonitoringUnits" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td> 
                        </tr>
                        <tr>
                            <td>14</td>
                            <td>Fire Fighting System</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="FireFightning" value="Yes" />
