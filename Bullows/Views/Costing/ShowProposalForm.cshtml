            <div class="section">
                <h4>TECHNICAL SPECIFICATION FOR PAINT BOOTH </h4>
                <table>
                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>Description</th>
                            <th>Specification</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Type</td>
                            @{
                                if (@Model.ProposalDetails.Category == 1)
                                {
                                    <td>Dry Paint Booth</td>
                                }
                                else
                                {
                                    <td>
                                        Wet Paint Booth
                                    </td>
                                }

                            }
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Working Size of paint booth in mm</td>
                            <td>@Model.ProposalDetails.Length mm L x @Model.ProposalDetails.WidthSize mm W x @Model.ProposalDetails.HeightSize mm H</td> <!-- Variable for Working Size -->
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Extraction Chamber</td>
                        <td></td> 
                        </tr>
                        <tr>
                            <td>4</td>
                            <td>Planum Chamber Size in mm</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="PlenumChamber" value="Yes"  />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="PlenumChamber" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>5</td>
                            <td>Fresh Air Supply Unit</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="FraishAirSupply" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="FraishAirSupply" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td> 
                        </tr>
                        <tr>
                            <td>6</td>
                            <td>Average Velocity inside booth</td>
                            <td>@* @Model.AverageVelocity *@</td> <!-- Variable for Average Velocity -->
                        </tr>
                        <tr>
                            <td>7</td>
                            <td>
                                Material of Construction
                                <ul>
                                    <li>Panels (Booth Enclosure):</li>
                                    <li>Panels (Extraction Chamber):</li>
                                    <li>Exhaust Chamber:</li>
                                    <li>Exhaust Ducting:</li>
                                </ul>
                            </td>
                            <td>@Model.MaterialList.Materials</td>


                        </tr>
                        <tr>
                            <td>8</td>
                            <td>Viewing Glass</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="ViewingGlass" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="ViewingGlass" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>9</td>
                            <td>Painting Inside & Outside</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="PaintingInside" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                      
                                        <input type="radio" name="PaintingInside" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td> 
                        </tr>
                        <tr>
                            <td colspan="3" style="font-weight: bold; text-align: left;">
                                Exhaust Blower Specifications
                            </td>
                        </tr>
                        <tr>
                            <td>10</td>
                            <td>Type</td>
                            <td>Centrifugal Blower</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>MOC</td>
                            <td>@Model.MaterialList.Materials</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>Exhaust Capacity</td>
                            <td>@Model.MaterialList.EXhaustCapacity</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>Motor Capacity</td>
                            <td>@* @Model.ExhaustMotorCapacity *@</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>VFD</td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="VFD" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="VFD" value="No" checked />
                                        No
                                    </label>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>Blower Mounting</td>
                            <td><input type ="text" class="form-control"/></td>
