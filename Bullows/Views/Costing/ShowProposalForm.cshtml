<script>
           

    function downloadPDF() {
        var element = document.getElementById('divProposal');
        var options = {
            filename: 'Report.pdf',
            margin: [10, 10, 10, 10],
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        // Generate the PDF and add page numbers
        html2pdf().from(element).set(options).toPdf().get('pdf').then(function (pdf) {
            const totalPages = pdf.internal.getNumberOfPages();

            // Add page numbers to each page
            for (let i = 1; i <= totalPages; i++) {
                pdf.setPage(i);
                pdf.setFontSize(10);
                pdf.text(`Page ${i} of ${totalPages}`, pdf.internal.pageSize.getWidth() - 20, pdf.internal.pageSize.getHeight() - 10);
            }
        }).save();
    }

    $(document).ready(function () {
        $('input[name="item1"]').change(function () {
            console.log("Checkbox state changed!");
            if (!$(this).is(':checked')) {
                console.log("Checkbox unchecked. Hiding #BlastingRoom.");
                $("#BlastingRoom").hide();
            } else {
                console.log("Checkbox checked. Showing #BlastingRoom.");
                $("#BlastingRoom").show();
            }
        });

        function calculateTotalPrice() {
            let total = 0;
            $('.price-input').each(function () {
                let value = parseFloat($(this).val()) || 0; // Parse value or use 0 if invalid/empty
                total += value;
            });
            $('#totalPrice').val(total.toFixed(2)); // Format to 2 decimal places
        }

        // Call calculateTotalPrice on input event of any price-input field
        $('.price-input').on('input', calculateTotalPrice);

        // Initial calculation on page load (if fields are pre-filled)
        calculateTotalPrice();

        // Function to update GST text and calculate GST amount
        function updateGSTTextAndAmount() {
            let gstPercentage = parseFloat($('.gst-percentage-input').val()) || 0;
            $('#gstText').text(`${gstPercentage}% GST will be applicable at extra. GST No: 27AAACB5489M1Z5`);
        }
        $('.gst-percentage-input').on('input', updateGSTTextAndAmount);

        // Initial update on page load
        updateGSTTextAndAmount();
    });
</script>



