                        </tr>
                        <tr>
                            <td></td>
                            <td>Quantity :</td>
                            <td>@Model.MaterialList.TubelightQuantity</td>
                        </tr>
                        
                        <tr>
                            <td>12</td>
                            <td>Sampling Port </td>
                            <td>
                                <div class="radio-buttons">
                                    <label>
                                        <input type="radio" name="SamplingPort" value="Yes" />
                                        Yes
                                    </label>
                                    <label>
                                        <input type="radio" name="SamplingPort" value="No" checked />
