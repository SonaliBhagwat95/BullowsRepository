 function getTotalPayment() {
        let total = 0;
        $('#priceBID input[id$="Advance"], #priceBID input[id$="DAP"], #priceBID input[id$="SUPPLYBEFOREDISPATCH"], #priceBID input[id$="SUPPLYAFTERDISPATCH"], #priceBID input[id$="Instalation"], #priceBID input[id$="COMMISSIONING"]').each(function(){
            let val = parseFloat($(this).val()) || 0;
            total += val;
        });
        return total;
    }

    function updatePaymentRemaining() {
        let totalEntered = getTotalPayment();
        let remaining = 100 - totalEntered;
        $('#txtPaymentRemaining').val(remaining);

        // Color logic
        if(totalEntered === 100){
            $('#txtPaymentRemaining').css({'background-color':'#28a745','color':'white'}); // green
        }
        else if(totalEntered < 100){
            $('#txtPaymentRemaining').css({'background-color':'#ffc107','color':'black'}); // orange
        }
        else {
            $('#txtPaymentRemaining').css({'background-color':'#dc3545','color':'white'}); // red
            alert("Total percentage cannot exceed 100%");
        }
    }

    // Trigger update on input
    $('#priceBID input[id$="Advance"], #priceBID input[id$="DAP"], #priceBID input[id$="SUPPLYBEFOREDISPATCH"], #priceBID input[id$="SUPPLYAFTERDISPATCH"], #priceBID input[id$="Instalation"], #priceBID input[id$="COMMISSIONING"]').on('input', function() {
        updatePaymentRemaining();
    });

    // Intercept form submission
    $('form').on('submit', function(e){
        let total = getTotalPayment();
        if(total !== 100){
            e.preventDefault(); // prevent submission
            alert("Total Payment Terms percentage must be exactly 100% to save!");
        }
    });

    // Initialize remaining
    $('#txtPaymentRemaining').val(100).css({'background-color':'#ffc107','color':'black'});



    });
