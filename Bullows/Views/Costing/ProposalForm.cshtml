<script>
    $(document).ready(function () {
        // Enable the search button if the enquiry code is not empty
        $('#txtEnquiryCode').on('input', function () {
            var enquiryCode = $(this).val();
            if (enquiryCode.trim() !== "") {
                $('#searchbtn').prop('disabled', false);  // Enable button
            } else {
                $('#searchbtn').prop('disabled', true);   // Disable button
            }
        });

        // Handle search button click to show the proposal content
        $('#searchbtn').on('click', function () {
            var enquiryCode = $('#txtEnquiryCode').val().trim();

            if (enquiryCode !== "") {

                // Show the proposal content
                $('#proposalContent').show();
            }
        });
    });
</script>
