@model Bullows.Model.SettingModel
@{
    ViewData["Title"] = "PanelInput";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }

    .table-responsive {
        position: relative;
        max-height: 400px;
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background: gray !important;
        z-index: 10;
    }
</style>

<div>
    @if (!string.IsNullOrEmpty(ViewBag.Result))
    {
        <span>@ViewBag.Result</span>
    }

</div>
<div class="divPanel">
    <form asp-action="SaveSetting" asp-controller="PanelSetting" method="post" data-ajax="true" data-ajax-update="divPanel">
        <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <div class="cl-md-12 col-lg-12 col-sm-12" id="div9boxwithimag">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-4 ">
                                @Html.HiddenFor(c=>c.SId)
                                <label class="smaller-font">Enquiry Code</label>
                                @Html.TextBoxFor(c=>c.SalesNo, new { @id = "txtEnquiryCode", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                <div id="resultsContainer" class="results-container"></div>
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Panel Width (mm)</label>
                                @*  @Html.ValidationMessageFor(c => c.PanelWidth, "", new { @class = "text-danger" }) *@
                                @Html.TextBoxFor(c => c.PanelWidth, new { @class = "form-control smaller-font smaller-height", @id = "txtPanelWidth", style = "width: 130px;", placeholder = " Panel Width", Value = "1140" })
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Panel Height (mm)</label>
                                @*   @Html.ValidationMessageFor(c => c.PanelHeight, "", new { @class = "text-danger" }) *@
                                @Html.TextBoxFor(c => c.PanelHeight, new { @class = "form-control smaller-font smaller-height", @id = "txtPanelHeight", style = "width: 130px;", placeholder = " Panel Height", Value = "2390" })
                            </div>

                        </div><br />
                        <div class="row">

                            <div class="col-md-4">
                                <label class="smaller-font">Sheet Thickness (mm)</label>
                                @Html.ValidationMessageFor(c => c.SheetThickness, "", new { @class = "text-danger" })
                                @Html.DropDownListFor(c => c.SheetThickness, new List<SelectListItem>{ new SelectListItem {Text = "1.2", Value="1.2"}, new SelectListItem {Text = "1.6", Value="1.6"},
                                new SelectListItem{Text="2.0",Value="2.0"} }, "--Select--",
                                new { @id = "SheetThickness", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Section</label>
                                @Html.DropDownListFor(c => c.Section,
                                new List<SelectListItem>
                                {
                                new SelectListItem { Text = "Bend Section", Value = "Bend Section" },
                                new SelectListItem { Text = "Structural member", Value = "Structural member" },
                                },
                                "--Select--",
                                new { @id = "drpSection", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div>
                            @* <div class="col-md-4">
                                <label class="smaller-font">Bend/Structural M.</label>
                                @Html.DropDownListFor(c => c.BendSection, new List<SelectListItem>(), "--Select--", new { @id = "drpBendStructural", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div> *@
                            <div class="col-md-4">
                                <label class="smaller-font">Bend/Structural M.</label>

                                <!-- Main dropdown (predefined + Custom) -->
                                @Html.DropDownListFor(c => c.BendSection,
                                                                new List<SelectListItem>(),  // Will be populated by JS
                                                                "--Select--",
                                                                new { @id = "drpBendStructural", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })

                                <!-- Custom textbox - hidden by default -->
                                <input type="text"
                                       id="txtCustomBendSection"
                                       name="BendSection"  
                                class="form-control smaller-font smaller-height mt-2"
                                style="width: 130px; display: none;"
                                placeholder="Enter custom value"
                                value="@(Model.BendSection != null &&
                                                                !new[] { "70*40*3", "75*40*2", "100*50*2", "100*50*3", "ISMC 75*40", "ISMC 100*50", "custom" }.Contains(Model.BendSection)
                                                                ? Model.BendSection : "")" />
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-md-4">
                                <label class="smaller-font">StandardBend-1</label>
                                @Html.ValidationMessageFor(c => c.StandardBend1, "", new { @class = "text-danger" })
                                @Html.TextBoxFor(c => c.StandardBend1, new { @class = "form-control smaller-font smaller-height", @id = "txtPanelHeight", style = "width: 130px;", placeholder = "15" })

                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">StandardBend-2</label>
                                @Html.ValidationMessageFor(c => c.StandardBend2, "", new { @class = "text-danger" })
                                @Html.TextBoxFor(c => c.StandardBend2, new { @class = "form-control smaller-font smaller-height", @id = "txtPanelHeight", style = "width: 130px;", placeholder = "38" })
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Pitch Distance</label>
                                @Html.ValidationMessageFor(c => c.PitchDistance, "", new { @class = "text-danger" })
                                @Html.TextBoxFor(c => c.PitchDistance, new {@class = "form-control smaller-font smaller-height", @id = "txtPanelWidth", style = "width: 130px;", placeholder = " Distance" })
                            </div>

                        </div>
                        <br />
                        <div class="row">
                            <div class="col-md-4">
                                <label class="smaller-font">Slot Dimentions</label>
                                @Html.ValidationMessageFor(c => c.SlotDimention, "", new { @class = "text-danger" })
                                @Html.DropDownListFor(c => c.SlotDimention, new List<SelectListItem>{ new SelectListItem {Text = "10-12", Value="10-12"},
                                new SelectListItem{Text="10-18",Value="10-18"},new SelectListItem{Text="12-16",Value="12-16"} }, "--Select--",
                                new { @id = "SlotDimentions", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Materials</label>
                                @Html.DropDownListFor(c => c.Materials,
                                new List<SelectListItem>
                                {
                                new SelectListItem { Text = "G.I", Value = "G.I" },
                                new SelectListItem { Text = "MS", Value = "MS" },
                                new SelectListItem { Text = "SS304", Value = "SS304" },
                                new SelectListItem { Text = "Al", Value = "Al" }
                                },
                                "--Select--",
                                new { @id = "Materials", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div>
                            <div class="col-md-4">
                                <label class="smaller-font">Light Type</label>
                                @Html.DropDownListFor(c=>c.LightTypes,new  List<SelectListItem>{
                                new SelectListItem{Text="TubeLight",Value="TubeLight"},
                                new SelectListItem{Text="LED",Value="LED"},
                                },"---Select---",new {@id="drpLightType",@class="form-control smaller-font smaller-height", style = "width: 130px;"})
                            </div>
                        </div><br/>
                        <div class="row">

                            <div class="col-md-4">
                                <label class="smaller-font">Light Sub Type</label>
                                @Html.DropDownListFor(c=>c.LightSubTypes,new List<SelectListItem>{
                                new SelectListItem{Text="NFLP", Value="NFLP"},
                                new SelectListItem{Text="FLP",Value="FLP"}
                                },"---Select---",
                                new {@id="drpLightSubType",@class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                            </div>
                           
                        <div class="col-md-4">
                       <label class="smaller-font">Lux Level</label>
                            @Html.TextBoxFor(c=>c.LuxLevel,new {@id="txtLuxLevel",@class="form-control smaller-font smaller-height", style = "width: 130px;"})
                        </div>
                      
                        <div class="col-md-4">
                        <label class="smaller-font">Lumens</label>
                        @Html.TextBoxFor(c=>c.Lumens,new {@id="txtLumens",@class="form-control smaller-font smaller-height", style = "width: 130px;"})
                    </div>
                        </div>
                </div>
                    <div class="col-md-4">
                        <div class="col-md-6">
                            <img src="~/img/StandardBend1.jpg" alt="" style="width:300px;height:250px; border-style:dotted;border-width:2px;">
                        </div>
                    </div>
                </div>
                <br />

            </div>

            <div />
        </div><br />
        <div class="row">
            <div class="col-md-12 mt-3">
                <button type="submit" id="saveButton" class="btn btn-success rounded-pill" style="width:100px">Save</button>

            </div>
        </div>

        <div class="container" style="margin-top:10px;margin-left:-20px;">
            <div class="table-responsive" style="width:100% ;max-height:400px;overflow-y:scroll;">
                <table class="table">
                    <thead class="webgrid-header">
                        <tr>
                            <th>Sr.No.</th>
                            <th id="tableId" style="display:none;">SId</th>
                            <th>Enquiry code</th>
                            <th>PanelWidth</th>
                            <th>PanelHeight</th>
                            @* <th>standardBend-1</th>
                            <th>standardBend-2</th> *@
                            <th>SlotDimention</th>
                            @* <th>SheetThickness</th>
                            <th>PitchDistance</th> *@
                            <th>Section</th>
                            <th>Material</th>
                            <th>Action</th>



                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.GridData == null)
                        {
                            <tr><td colspan="9">No data available</td></tr>
                        }
                        else
                        {
                            int i = 0;
                            @foreach (var item in ViewBag.GridData)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>
                                    <td style="display:none;">@item.SId</td>
                                    <td>@item.SalesNo</td>
                                    <td>@item.PanelWidth</td>
                                    <td>@item.PanelHeight</td>
                                    @*
                            <td>@item.standardBend1</td>
                            <td>@item.standardBend2</td> *@
                                    <td>@item.SlotDimention</td>
                                    @*  <td>@item.SheetThickness</td>
                            <td>@item.PitchDistance</td> *@
                                    <td>@item.Section</td>
                                    <td>@item.Materials</td>
                                    <td>
                                        <a href="@Url.Action("panelSetting", "PanelSetting", new { id = item.SId })">
                                            <img style="height:20px;width:20px" src="~/img/pencil.jpg" title="Edit" />
                                        </a>
                                        <a href="@Url.Action("Delete", "PanelSetting", new { id = item.SId })">
                                            <img style="height:20px;width:20px" src="~/img/delete.png" title="Delete" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>




<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
