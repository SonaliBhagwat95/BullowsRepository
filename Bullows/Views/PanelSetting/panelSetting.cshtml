<script>
    $(document).ready(function () {
        var $sectionDropdown = $('#drpSection');
        var $bendDropdown = $('#drpBendStructural');
        var $customInput = $('#txtCustomBendSection');

        // Store the current custom value on postback
        var currentBendValue = '@Model.BendSection';  // Server-side value

        var bendOptions = [
            { Text: "70*40*3", Value: "70*40*3" },
            { Text: "75*40*2", Value: "75*40*2" },
            { Text: "100*50*2", Value: "100*50*2" },
            { Text: "100*50*3", Value: "100*50*3" }
        ];

        var structuralOptions = [
            { Text: "ISMC 75*40", Value: "ISMC 75*40" },
            { Text: "ISMC 100*50", Value: "ISMC 100*50" }
        ];

        function populateBendDropdown(options) {
            $bendDropdown.empty();
            $bendDropdown.append('<option value="">--Select--</option>');

            $.each(options, function (index, opt) {
                $bendDropdown.append('<option value="' + opt.Value + '">' + opt.Text + '</option>');
            });

            // Always add "Custom" option at the end
            $bendDropdown.append('<option value="custom">Custom</option>');

            // After populating, restore the previous value (if it's not custom)
            if (currentBendValue &&
                options.some(function(opt) { return opt.Value === currentBendValue; })) {
                $bendDropdown.val(currentBendValue);
            }

            updateCustomInputVisibility();
        }

        function updateCustomInputVisibility() {
            if ($bendDropdown.val() === "custom") {
                $customInput.show().focus();
                $bendDropdown.prop('disabled', true);  // Prevent "custom" from being posted
            } else {
                $customInput.hide().val('');
                $bendDropdown.prop('disabled', false);
            }

            // If postback had a custom value (not in predefined list), show it
            if (currentBendValue &&
                $bendDropdown.find('option[value="' + currentBendValue + '"]').length === 0 &&
                currentBendValue !== "custom" && currentBendValue !== "") {
                $bendDropdown.val("custom");
                $customInput.val(currentBendValue).show();
                $bendDropdown.prop('disabled', true);
            }
        }

        // On Section change
        $sectionDropdown.change(function () {
            var selectedSection = $(this).val();
            if (selectedSection === "Bend Section") {
                populateBendDropdown(bendOptions);
            } else if (selectedSection === "Structural member") {
                populateBendDropdown(structuralOptions);
            } else {
                $bendDropdown.empty().append('<option value="">--Select--</option>');
                $customInput.hide();
            }
        });

        // On Bend dropdown change
        $bendDropdown.change(function () {
            updateCustomInputVisibility();
        });

        // Initial load: trigger based on current Section
        if ($sectionDropdown.val()) {
            $sectionDropdown.trigger('change');
        } else {
            updateCustomInputVisibility(); // In case only custom was selected before
        }

        function bindEvents() {
        $('#txtEnquiryCode').on('keyup', function () {
            var enquiryCode = $(this).val();
            if (enquiryCode.length > 0) {
                $.ajax({
                    url: '@Url.Action("GetEnquiryCodes", "PanelSetting")',
                    type: 'POST',
                    data: { term: enquiryCode },
                    success: function (data) {
                        $('#resultsContainer').empty();
                        if (data.success && data.results.length > 0) {
                            data.results.forEach(function (item) {
                                $('#resultsContainer').append('<div>' + item + '</div>');
                            });
                        } else {
                            $('#resultsContainer').append('<div>Enquiry Code does not Available</div>');
                        }
                    },
                    error: function () {
                        $('#resultsContainer').empty();
                        $('#resultsContainer').append('<div>Error occurred while searching.</div>');
                    }
                });
            } else {
                $('#resultsContainer').empty();
            }
        });
        $(document).on('click', '#resultsContainer div', function () {
            var selectedCode = $(this).text();
            $('#txtEnquiryCode').val(selectedCode);
            $('#resultsContainer').empty();
        });

}


    });
</script>