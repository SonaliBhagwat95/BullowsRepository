</div>
 <div style="margin-top:10px;/* margin-right:10px */">
    <div class="table-responsive" style="width:90%;max-height:400px;overflow-y:scroll">
        <table class="table" id="dataGrid">
            <thead class="webgrid-header" style="background-color:gray">
                <tr>
                    <th>Sr.NO</th>
                    <th id="tableId" style="display:none;">CustomerID</th>
                    <th>CompanyName</th>
                    <th>Address</th>                  
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.GridCustomer == null)
                {
                    <tr><td colspan="5">No data available</td></tr>
                }
                else
                {
                    int i = 0;
                    @foreach (var item in ViewBag.GridCustomer)
                    {
                        i++;
                        <tr>
                            <td>@i</td>
                            <td style="display:none;">@item.CustomerID</td>
                            <td>@item.CompanyName</td>
                            <td>@item.CustomerAddress</td>                          
                            <td>
                                <a href="@Url.Action("Customer", "Customer", new { id = item.CustomerID })">
                                    <img style="height:20px;width:20px" src="~/img/pencil.jpg" title="Edit" />
                                </a>
                               
                                <a href="@Url.Action("Delete", "Customer", new { id = item.CustomerID })">
                                    <img style="height:20px;width:20px" src="~/img/delete.png" title="Delete" />
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>  

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@section Scripts {
    <script type="text/javascript">
        // Handle state dropdown change event
        $('#StateDropdown').change(function () {
            debugger;
            var stateId = $(this).val();

            if (stateId) {
                $.ajax({
                    url: '@Url.Action("GetCitiesByState", "Customer")',
                    type: 'GET',
                    data: { stateId: stateId },
                    success: function (data) {
                        $('#CityDropdown').empty();
                        $('#CityDropdown').append('<option value="">-- Select--</option>');

                        if (data && data.length > 0) {
                            $.each(data, function (index, city) {
                                $('#CityDropdown').append('<option value="' + city.value + '">' + city.text + '</option>');
                            });
                        } else {
                            $('#CityDropdown').append('<option value="">No cities available</option>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX request failed');
                        console.error('Status: ' + status);
                        console.error('Error: ' + error);
                        console.error('Response Text: ' + xhr.responseText);
                        alert('Error loading cities: ' + error);
                    }
                });
            } else {
                $('#CityDropdown').empty();
                $('#CityDropdown').append('<option value="">-- Select--</option>');
            }
        });
    </script>
}
        