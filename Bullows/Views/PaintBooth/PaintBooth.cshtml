                                <td style="text-align: center;">${item.description}</td>
                                <td style="text-align: center;">${item.pressureDrop_mm}</td>
                                <td><input type="number" class="quantity-input" data-id="${item.itemNumber}" style="width: 80px; text-align: center;" value="${quantity}"></td>
                                <td><input type="number" class="total-input" data-id="${item.itemNumber}" readonly style="width: 80px; text-align: center;"></td>
                            </tr>
                        `);
                        });
                        
                        // Add event listeners (checkbox change, quantity input change, etc.)
                        addEventListeners();
                        
                    } else {
                        tableBody.append('<tr><td colspan="6">No records found</td></tr>');
                    }

                    // Function to add all event listeners for the new grid
                    function addEventListeners() {
                        $(".select-row-checkbox").on("change", function () {
                            var row = $(this).closest("tr"); // Get the row of the clicked checkbox
                            if (!$(this).prop("checked")) {
                                // Disable Quantity and Total inputs when checkbox is unchecked
                                row.find(".quantity-input, .total-input").prop("disabled", true);
                                // Clear the total if the checkbox is unchecked
                                row.find(".total-input").val("");
                            } else {
                                // Enable Quantity and Total inputs when checkbox is checked
                                row.find(".quantity-input, .total-input").prop("disabled", false);
                            }
                            // Update the grand total when the checkbox is toggled
                            updateGrandTotal();
                        });
                        
                        $(".quantity-input").on("input", function () {
                            var quantity = parseFloat($(this).val());
                            var pressureDrop = parseFloat($(this).closest('tr').find('td:nth-child(4)').text()); // Pressure Drop is in 4th column
                            var totalInput = $(this).closest('tr').find('.total-input');

                            // Calculate total if quantity and pressureDrop are numbers
                            if (!isNaN(quantity) && !isNaN(pressureDrop)) {
                                var total = quantity * pressureDrop;
                                totalInput.val(total.toFixed(2)); // Update the Total textbox
                            } else {
                                totalInput.val(""); // Clear total if invalid input
                            }

                            // Recalculate the grand total
                            updateGrandTotal();
                        });

                        // Add event listener for addition factor input change
                        $("#additionFactor").on("input", function () {
                            updateGrandTotal(); // Update grand total when the addition factor changes
                        });
                    }

                    // Update grand total based on row totals
                    function updateGrandTotal() {
                        grandTotal = 0;
                        $(".total-input").each(function () {
                            // Only add to grand total if the row is not disabled
                            if (!$(this).closest('tr').find('.select-row-checkbox').prop("checked")) {
                                return; // Skip this row if the checkbox is unchecked
                            }

                            var rowTotal = parseFloat($(this).val());
                            if (!isNaN(rowTotal)) {
                                grandTotal += rowTotal;
                            }
                        });

                        // Get the value from the addition factor input field
                        var additionFactor = parseFloat($("#additionFactor").val()) || 0;
                        grandTotal += additionFactor; // Add addition factor to grand total

                        // Display the grand total in the table
                        $("#grandTotal").text(grandTotal.toFixed(2));

                        // Set the grand total into the Water Column TextBox
                        $("#txtWater").val(grandTotal.toFixed(2));
                        // Call calculateBlowerHp when the value is set
                        calculateBlowerHp();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data:", error);
                }
            });
        });

        

