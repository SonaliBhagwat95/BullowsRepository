    function bindEvents() {
        $('#txtEnquiryCode').on('keyup', function () {
            var enquiryCode = $(this).val();
            if (enquiryCode.length > 0) {
                $.ajax({
                    url: '@Url.Action("GetEnquiryCodes", "PaintBooth")',
                    type: 'POST',
                    data: { term: enquiryCode },
                    success: function (data) {
                        $('#resultsContainer').empty();
                        if (data.success && data.results.length > 0) {
                            data.results.forEach(function (item) {
                                $('#resultsContainer').append('<div>' + item + '</div>');
                            });
                        } else {
                            $('#resultsContainer').append('<div>Enquiry Code does not Available</div>');
                        }
                    },
                    error: function () {
                        $('#resultsContainer').empty();
                        $('#resultsContainer').append('<div>Error occurred while searching.</div>');
                    }
                });
            } else {
                $('#resultsContainer').empty();
            }
        });

        $(document).on('click', '#resultsContainer div', function () {
            var selectedCode = $(this).text();
            $('#txtEnquiryCode').val(selectedCode);
            $('#resultsContainer').empty();
        });

        $(document).on('click', '#btnNext', function () {
            window.location.href = '@Url.Action("BOCalculations", "Costing")';
        });
    }
