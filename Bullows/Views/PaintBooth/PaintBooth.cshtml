      function calculateBlowerHp() {
          // Get the values from the input fields
          var capacityReadonly = parseFloat($('#txtCapacityofBlowerinHReadonly').val()) || 0;
          var capacityRoundOf = parseFloat($('#txtCapacityofBlowerRoundOf').val()) || 0;
          var waterColumn = parseFloat($('#txtWater').val()) || 0;

          // Use the rounded off value if it's provided, otherwise use the readonly value
          var capacity = capacityRoundOf > 0 ? capacityRoundOf : capacityReadonly;

          // Perform the calculation
          var blowerHp = (capacity * waterColumn) / (3600 * 75 * 0.67);

          // Set the calculated value in the txtHPCalculations textbox
          $('#txtHPCalculations').val(blowerHp.toFixed(2)); // Round to 2 decimal places

          // Check the value after updating it
          checkBlowerHpValue(); // Ensure the button state is updated
      }
