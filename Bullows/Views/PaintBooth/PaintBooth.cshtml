                            <th>Length</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Rows will be added dynamically -->
                    </tbody>
                </table>
                </div>
                <h6>Blower Power Calculations</h6>
                <div class="row">
