                newTextboxValue = 4 * standardPanelHeight; // Same value for 4 and 4.5
                break;
            default:
                // Convert the selected text to a number for other values
                var multiplier = parseFloat(selectedText);
                newTextboxValue = multiplier * standardPanelHeight; // Calculate new value for all other selections
                break;
        }
        console.log("newTextboxValue:", newTextboxValue);
        // Update the textbox with the calculated or selected value
        $('#txt2panelsizeforW').val(newTextboxValue);

    }
    //for H calculations
    function calculateStandardPanelsforH(standardPanelHeight) {
        var H = parseFloat($('#txtH').val()) || 0;

        var panelheightCa = standardPanelHeight;
        console.log("Standard Panels Height:", panelheightCa);
        // var standardPanelSize = 2390;
        var standardPanels = Math.floor(H / standardPanelHeight);

        var product = standardPanels * standardPanelHeight;
        $('#txt2panelsizeforH').val(product);
        updateDropdownOptionsforH(standardPanels);
        showoptionsindropdownforH(standardPanelHeight);
    }

    function calculatePanelsforH(standardPanelHeight) {
        var height = standardPanelHeight;
        console.log("height", height);
        var wValue = parseFloat($("#txtH").val());
        if (wValue && height) {
            var standardPanelsByHeight = Math.floor(wValue / height);
            console.log("standardPanelsByWidth", standardPanelsByHeight);
            var remainingWidthpanels = wValue - (standardPanelsByHeight * height);

            // Update the textboxes
            $("#txtstandardPanelsByH").val(standardPanelsByHeight);
            $("#txtremaingPanelsByH").val(remainingWidthpanels);
        }
    }
    function updateDropdownOptionsforH(standardPanels) {
        // Clear previous dropdown options
        var dropdown = $('#panelSizeDropdownforH');
        var currentValue = dropdown.val(); // Get the currently selected value
        dropdown.empty(); // Clear existing options
        // Define all dropdown options
        var options = [
            { Text: "1", Value: "1" },
            // { Text: "1.5", Value: "2" },
            { Text: "2", Value: "3" },
            // { Text: "2.5", Value: "4" },
            { Text: "3", Value: "5" },
            // { Text: "3.5", Value: "6" },
            { Text: "4", Value: "7" },
            // { Text: "4.5", Value: "8" },
            { Text: "5", Value: "9" },
            // { Text: "5.5", Value: "10" },
            { Text: "6", Value: "11" },
            // { Text: "6.5", Value: "12" },
            { Text: "7", Value: "13" },
            // { Text: "7.5", Value: "14" }
        ];


        let newOptions;
        if (standardPanels === 1) {
            // Add first 3 options
            newOptions = options.slice(0, 2); // "1", "1.5", "2"
        } else if (standardPanels === 2) {
            // Add options for standardPanels equal to 2
            newOptions = options.slice(1, 3); // "2", "2.5", "3"
        } else if (standardPanels === 3) {
            // Add options for standardPanels equal to 3
            newOptions = options.slice(2, 4); // "3.5", "4", "4.5"
        } else if (standardPanels === 4) {
            // Add options for standardPanels equal to 4
            newOptions = options.slice(3, 5); // "5", "5.5", "6"
        } else {
            // Add all remaining options if standardPanels is larger
            newOptions = options.slice(11); // "6.5", "7", "7.5"
        }

        // Add new options to the dropdown
        addOptionsToDropdownforH(dropdown, newOptions);

        // Set the previously selected value, if it's still available in the new options
        if (newOptions.some(option => option.Value === currentValue)) {
            dropdown.val(currentValue); // Re-select the previous value
        } else {
            dropdown.val(''); // Reset the value if the previous option is not available
        }

    }
    function addOptionsToDropdownforH(dropdown, options) {
        options.forEach(function (option) {
            dropdown.append($('<option>', {
                value: option.Value,
                text: option.Text
            }));
        });
    }
    function showoptionsindropdownforH(standardPanelHeight) {
        var handlePanelheight = standardPanelHeight;
        var selectedValue = $('#panelSizeDropdownforH').val();

        var halfPanelSize = handlePanelheight/2; // Adjust as needed

        if (selectedValue === "1" || selectedValue === "3" || selectedValue === "5" ||
            selectedValue === "7" || selectedValue === "9" || selectedValue === "11" ||
            selectedValue === "13" || selectedValue === "15") {

            $('#txthalfpanelsizeforH').hide();
            $('#divStandardSizeforH').show();
            $('#divHalfSizeforH').hide();
            $('#txt2panelsizeforH').show();
        } else if (selectedValue === "2" || selectedValue === "4" || selectedValue === "6" ||
            selectedValue === "8" || selectedValue === "10" || selectedValue === "12" ||
            selectedValue === "14") {

            $('#txthalfpanelsizeforH').val(halfPanelSize).show();
            $('#divStandardSizeforH').show();
            $('#divHalfSizeforH').show();
            $('#txt2panelsizeforH').show();
        } else {
            // If no valid value is selected, hide everything
            $('#divStandardSizeforH').hide();
            $('#divHalfSizeforH').hide();
            $('#txthalfpanelsizeforH').val('');
            $('#txt2panelsizeforH').val('');
        }
    }
    function showvalueasperchangedropdownforH(standardPanelHeight) {
        var selectedText = $('#panelSizeDropdownforH option:selected').text();
        // Initialize newTextboxValue
        var newTextboxValue;

        // Determine the textbox value based on selected text
        switch (selectedText) {
            case "1":
            case "1.5":
                newTextboxValue = standardPanelHeight; // Same value for 1 and 1.5
                break;
            case "2":
            case "2.5":
                newTextboxValue = 2 * standardPanelHeight; // Same value for 2 and 2.5
                break;
            case "3":
            case "3.5":
                newTextboxValue = 3 * standardPanelHeight; // Same value for 3 and 3.5
                break;
            case "4":
            case "4.5":
                newTextboxValue = 4 * standardPanelHeight; // Same value for 4 and 4.5
                break;
            default:
                // Convert the selected text to a number for other values
                var multiplier = parseFloat(selectedText);
                newTextboxValue = multiplier * standardPanelHeight; // Calculate new value for all other selections
                break;
        }

        // Update the textbox with the calculated or selected value
        $('#txt2panelsizeforH').val(newTextboxValue);
    }
