@model Bullows.Model.PaintBoothModel
@{
    ViewData["Title"] = "PaintBooth";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">


<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }

    #resultsContainer {
        max-height: 150px;
        overflow-y: auto;
        border: 1px solid #ccc;
        background-color: #f9f9f9;
        padding: 5px;
        margin-top: 5px;
    }

        #resultsContainer div {
            padding: 5px;
            cursor: pointer;
        }

        #resultsContainer div:hover {
            background-color: #eaeaea;
        } 
</style>

<div class="divPaintBooth" style="margin-left:20px;">
    <form asp-action="SavePaintBoothDetails" asp-controller="PaintBooth" method="post" data-ajax="true" data-ajax-update="divPaintBooth">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="col-lg-12 col-md-12 col-sm-12" id="DivWithImg">
                <div class="row">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-md-3 ">
                                <label class="smaller-font">Enquiry Code</label>
                                @Html.TextBoxFor(c=>c.SalesNO, new { @id = "txtEnquiryCode", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                <div id="resultsContainer" class="results-container" style="display: none;"></div>
                            </div>
                            <div class="col-md-2" style="padding-top:15px;">
                                <button type="button" id="searchbtn" class="btn btn-primary rounded-pill" style="width:100px;" disabled>Search</button>
                            </div>
                            <div class="col-md-2" style="padding-top:15px;margin-left:20px;">
                                <button type="button" id="showSettingDetails" class="btn btn-success rounded-pill" style="width:100px;" disabled>Setting</button>
                            </div> 
                        </div>
                        <hr />
                         <div class="modal fade" id="settingsModal" tabindex="-1" role="dialog" aria-labelledby="settingsModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="settingsModalLabel">Setting </h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body" id="modalContent">
                                        <!-- Randomized data will be dynamically injected here -->
                                    </div>
                                    @* <div class="modal-footer">
                                        <button type="button" class="btn btn-success" data-dismiss="modal">Close</button>
                                    </div> *@
                                </div>
                            </div>
                        </div> 
                        <div id="divComponantsdetails">
                            <h6>Components Details</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Length</label>
                                    @Html.TextBoxFor(c =>c.Depth,new{@id="txtlenght",@class="form-control smaller-font smaller-height",style= "width:120px;" ,@readonly="readonly"})
                                </div>

                                <div class="col-md-3">
                                    <label class="smaller-font">Width</label>
                                    @Html.TextBoxFor(c => c.Width, new { @id = "txtwidth", @class = "form-control  smaller-font smaller-height", style = "width:120px;",@readonly="readonly" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Height</label>
                                    @Html.TextBoxFor(c => c.Height, new { @id = "txtheight", @class = "form-control smaller-font smaller-height", style = "width:120px;",@readonly="readonly" })
                                </div>
                            </div>
                            <hr />
                            <h6>Paint Booth Details</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">D1</label>
                                    @Html.TextBoxFor(c=>c.D1,new{@id="txtD1",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">D2</label>
                                    @Html.TextBoxFor(c=>c.D2,new{@id="txtD2",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">D3</label>
                                    @Html.TextBoxFor(c=>c.D3,new{@id="txtD3",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">W1</label>
                                    @Html.TextBoxFor(c=>c.W1,new{@id="txtw1",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">W2</label>
                                    @Html.TextBoxFor(c=>c.W2,new{@id="txtw2",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">W3</label>
                                    @Html.TextBoxFor(c=>c.W3,new{@id="txtw3",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">H1</label>
                                    @Html.TextBoxFor(c=>c.H1,new{@id="txtH1",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">H2</label>
                                    @Html.TextBoxFor(c=>c.H2,new{@id="txtH2",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Depth(mm)</label>
                                    @Html.TextBoxFor(c=>c.D,new{@id="txtD",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                @*  new code for adding standard and nonstandard panels *@

                                <div class="col-md-3">
                                    <label for="CategoryDropdown" class="smaller-font">Panel Type:</label>
                                    @Html.DropDownListFor(c => c.PanelTypes, new List<SelectListItem>{ new SelectListItem {Text = "Standard Panel", Value="1"},
                                    new SelectListItem {Text = "Non-Standard Panel", Value="2"},
                                    }, "--Select--",
                                    new { @id = "drpPaneltype", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                </div>

                                <div class="col-md-3" id="txtstandardPanelDropdown" style="display:none;">
                                    <label for="CategoryDropdown" class="smaller-font">Panel Size:</label>
                                    @Html.DropDownListFor(c=>c.PanelsizeforD, new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "1",   Value = "1" },
                                    new SelectListItem { Text = "1.5", Value = "2" }, // Keep the text as value
                                    new SelectListItem { Text = "2",   Value = "3" },
                                    new SelectListItem { Text = "2.5", Value = "4" },
                                    new SelectListItem { Text = "3",   Value = "5" },
                                    new SelectListItem { Text = "3.5", Value = "6" },
                                    new SelectListItem { Text = "4",   Value = "7" },
                                    new SelectListItem { Text = "4.5", Value = "8" },
                                    new SelectListItem { Text = "5",   Value = "9" },
                                    new SelectListItem { Text = "5.5", Value = "10" },
                                    new SelectListItem { Text = "6",   Value = "11" },
                                    new SelectListItem { Text = "6.5", Value = "12" },
                                    new SelectListItem { Text = "7",   Value = "13" },
                                    new SelectListItem { Text = "7.5", Value = "14" },
                                    }, "--Select--",
                                    new { id = "panelSizeDropdown", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                  
                                </div>
                                <div class="col-md-3" id="divStandardSize">
                                    <label class="smaller-font">Standard Size</label>
                                    @Html.TextBoxFor(c=>c.StandardPanelWidthForD , new { id = "txt2panelsize", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <br />
                                <div class="col-md-3" id="divHalfSize">
                                    <label class="smaller-font">Half Panel Size</label>
                                    @Html.TextBoxFor(c=>c.HalfPanelswidthforD, new {id = "txthalfpanelsize", @class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <br />
                                <div class="row" id="NonStandardPanel">
                                    <div class="col-md-3">
                                        <label class="smaller-font">Standard Panels</label>
                                        @Html.TextBoxFor(c=>c.StandardPanels,new{@id="txtstandardPanels",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                    </div>
                                    <div class="col-md-3">
                                        <label class="smaller-font">Remaining Panels</label>
                                        @Html.TextBoxFor(c=>c.RemainingPanels,new{@id="txtremaingPanels",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                    </div>
                                    @* <div class="col-md-3">
                                        <lable class="smaller-font">Make it equal panels</lable>
                                        @Html.CheckBoxFor(c => c.MakeItEqual, new { @id = "chkMakeItEqual" })
                                    </div> *@
                                </div>

                            </div> <br />
                            <div class="row" id="equalPanelsDiv">
                                <div class="col-md-3">
                                    <lable class="smaller-font">Equal P.W</lable>
                                    @Html.TextBoxFor(c=>c.EqualPanelWidthForD,new{@id="txtEqualPanels",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <lable class="smaller-font">Total Panels</lable>
                                    @Html.TextBoxFor(c=>c.TotalPanels,new{@id="txtTotalpanels",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Width(mm)</label>
                                    @Html.TextBoxFor(c=>c.W,new{@id="txtw",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Panel Type:</label>
                                    @Html.DropDownListFor(c => c.PanelTypesforW, new List<SelectListItem>{ new SelectListItem {Text = "Standard Panel", Value="1"},
                                    new SelectListItem {Text = "Non-Standard Panel", Value="2"},
                                    }, "--Select--",
                                    new { @id = "drpPaneltypeforW", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                </div>

                                <div class="col-md-3" id="txtstandardPanelDropdownByW">
                                    <label for="CategoryDropdown" class="smaller-font">Panel Size:</label>
                                    @Html.DropDownListFor(c=>c.PanelsizeforW, new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "1", Value = "1" },
                                    new SelectListItem { Text = "1.5", Value = "2" },
                                    new SelectListItem { Text = "2", Value = "3" },
                                    new SelectListItem { Text = "2.5", Value = "4" },
                                    new SelectListItem { Text = "3", Value = "5" },
                                    new SelectListItem { Text = "3.5", Value = "6" },
                                    new SelectListItem { Text = "4", Value = "7" },
                                    new SelectListItem { Text = "4.5", Value = "8" },
                                    new SelectListItem { Text = "5", Value = "9" },
                                    new SelectListItem { Text = "5.5", Value = "10" },
                                    new SelectListItem { Text = "6", Value = "11" },
                                    new SelectListItem { Text = "6.5", Value = "12" },
                                    new SelectListItem { Text = "7", Value = "13" },
                                    new SelectListItem { Text = "7.5", Value = "14" },
                                    }, "--Select--",
                                    new { id = "panelSizeDropdownforW", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                </div>
                                <div class="col-md-3" id="divStandardSizeforW">
                                    <label class="smaller-font">Standard Size</label>
                                    @Html.TextBoxFor(c=>c.PanelHeightforW, new { id = "txt2panelsizeforW", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <br />
                                <div class="col-md-3" id="divHalfSizeforW">
                                    <label class="smaller-font">Half Panel Size</label>
                                    @Html.TextBoxFor(c=>c.HalfPanelsHeightforW, new {id = "txthalfpanelsizeforW", @class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <br />
                                <div class="row" id="NonStandardPanelforW">                               
                                <div class="col-md-3" id="divStandardPanels">
                                    <label class="smaller-font">Standard Panels</label>
                                    @Html.TextBoxFor(c=>c.StandardPanelsByW,new{@id="txtstandardPanelsByW",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3" id="divRemainingPanels">
                                    <label class="smaller-font">Remaining Panels</label>
                                    @Html.TextBoxFor(c=>c.RemainingPanelsByW,new{@id="txtremaingPanelsByW",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                               @*  <div class="col-md-3" id="divmakeitequal">
                                    <lable class="smaller-font">Make it equal panels</lable>
                                    @Html.CheckBoxFor(c => c.MakeItEqualByW, new { @id = "chkMakeItEqualByW" })
                                </div> *@
                                </div>
                            </div>
                            <br />
                            <div class="row" id="equalPanelsDivByW">
                                <div class="col-md-3">
                                    <lable class="smaller-font">Equal P.W(w)</lable>
                                    @Html.TextBoxFor(c=>c.EqualPanelWidthByW,new{@id="txtEqualPanelsByW",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <lable class="smaller-font">Total Panels(w)</lable>
                                    @Html.TextBoxFor(c=>c.TotalPanelsByW,new{@id="txtTotalpanelsByW",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Height(mm)</label>
                                    @Html.TextBoxFor(c=>c.H,new{@id="txtH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Panel Type:</label>
                                    @Html.DropDownListFor(c => c.PanelTypesforH, new List<SelectListItem>{ new SelectListItem {Text = "Standard Panel", Value="1"},
                                    new SelectListItem {Text = "Non-Standard Panel", Value="2"},
                                    }, "--Select--",
                                    new { @id = "drpPaneltypeforH", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                </div>

                                <div class="col-md-3" id="txtstandardPanelDropdownByH" style="display:none;">
                                    <label class="smaller-font">Panel Size:</label>
                                    @Html.DropDownListFor(c=>c.PanelsizeforH, new List<SelectListItem>
                                    {
                                    new SelectListItem { Text = "1", Value = "1" },
                                    new SelectListItem { Text = "1.5", Value = "2" },
                                    new SelectListItem { Text = "2", Value = "3" },
                                    new SelectListItem { Text = "2.5", Value = "4" },
                                    new SelectListItem { Text = "3", Value = "5" },
                                    new SelectListItem { Text = "3.5", Value = "6" },
                                    new SelectListItem { Text = "4", Value = "7" },
                                    new SelectListItem { Text = "4.5", Value = "8" },
                                    new SelectListItem { Text = "5", Value = "9" },
                                    new SelectListItem { Text = "5.5", Value = "10" },
                                    new SelectListItem { Text = "6", Value = "11" },
                                    new SelectListItem { Text = "6.5", Value = "12" },
                                    new SelectListItem { Text = "7", Value = "13" },
                                    new SelectListItem { Text = "7.5", Value = "14" },
                                    }, "--Select--",
                                    new { id = "panelSizeDropdownforH", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                                </div>
                                <div class="col-md-3" id="divStandardSizeforH">
                                    <label class="smaller-font">Standard Size</label>
                                    @Html.TextBoxFor(c=>c.PanelHeightforH, new { id = "txt2panelsizeforH", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <br />
                                <div class="col-md-3" id="divHalfSizeforH">
                                    <label class="smaller-font">Half Panel Size</label>
                                    @Html.TextBoxFor(c=>c.HalfPanelsHeightforH, new {id = "txthalfpanelsizeforH", @class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <br />
                                <div class="row" id="NonStandardPanelforH">
                                    <div class="col-md-3" id="divStandardPanelsH">
                                        <label class="smaller-font">Standard Panels</label>
                                        @Html.TextBoxFor(c=>c.StandardPanelsByH,new{@id="txtstandardPanelsByH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                    </div>
                                    <div class="col-md-3" id="divRemainingPanelsH">
                                        <label class="smaller-font">Remaining Panels</label>
                                        @Html.TextBoxFor(c=>c.RemainingPanelsByH,new{@id="txtremaingPanelsByH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                    </div>
                                    @* <div class="col-md-3" id="divmakeitequalH">
                                        <lable class="smaller-font">Make it equal panels</lable>
                                        @Html.CheckBoxFor(c => c.MakeItEqualByH, new { @id = "chkMakeItEqualByH" })
                                    </div> *@
                                </div>
                                
                            </div>
                            @*    <br /> *@
                            <div class="row" id="equalPanelsDivByH">
                                <div class="col-md-3">
                                    <lable class="smaller-font">Equal P.W(H)</lable>
                                    @Html.TextBoxFor(c=>c.EqualPanelWidthByH,new{@id="txtEqualPanelsByH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                                <div class="col-md-3">
                                    <lable class="smaller-font">Total Panels(H)</lable>
                                    @Html.TextBoxFor(c=>c.TotalPanelsByH,new{@id="txtTotalpanelsByH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <img src="~/img/PaintBooth.png" alt="" style="width:200px;height:400px;">
                    </div>
                </div>
            </div>
            <hr />
            <div class="row" id="ServiceDoormainDiv">
                <div class="col-md-4" id="iddivServiceDoor">
                    <lable class="smaller-font">Do you want to added Service Door ?</lable>
                    @Html.CheckBoxFor(c => c.chkServiceDoor, new { @id = "chkServiceDoor" })
                </div>
                <div id="serviceDoorDimentions" class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Service Door Location</label>
                        @Html.DropDownListFor(c => c.ServiceDoorLocation, new List<SelectListItem>
                        {
                        new SelectListItem { Text = "LeftSide", Value = "LeftSide" },
                        new SelectListItem { Text = "RightSide", Value ="RightSide" },
                        new SelectListItem { Text = "Both Side", Value ="Both Side" },
                        }, "--Select--", new { @id = "drpServiceDoorLocation", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                        @Html.ValidationMessageFor(c => c.ServiceDoorLocation, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3" id="iddivServiceDoor">
                        <lable class="smaller-font"> Service Door Height(mm)</lable>
                        @Html.TextBoxFor(c=>c.DoorHeight,new{@id="txtDoorHeight",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3" id="iddivServiceDoor">
                        <lable class="smaller-font">Service Door Width(mm)</lable>
                        @Html.TextBoxFor(c=>c.DoorWidth,new{@id="txtDoorWidth",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>

                </div>
            </div>
            <div id="divBlower">
                <hr />
                <h6>Blower Capacity</h6>
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">C/S Area (sq m)</label>
                        @Html.TextBoxFor(c=>c.CrossSectionalArea,new{@id="txtCrossSectionalArea",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Velocity(Blower)(m/s)</label>
                        @Html.TextBoxFor(c=>c.VelocityofBlower,new{@id="txtVelocityofBlower",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Sec)</label>
                        @Html.TextBoxFor(c=>c.CapacityofBlower,new{@id="txtCapacityofBlower",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Hr)</label>
                        @Html.TextBoxFor(c=>c.CapacityofBlowerinH,new{@id="txtCapacityofBlowerinH",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                </div>
                <hr />
                <h6>Filter Frame Design</h6>
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Hr)</label>
                        @Html.TextBoxFor(c=>c.CapacityofBlowerinH,new{@id="txtCapacityofBlowerinHReadonly",@class="form-control smaller-font smaller-height", style = "width:120px;",@readonly="readonly"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font"> Rounding Up Capacity</label>
                        @Html.TextBoxFor(c=>c.CapacityofBlowerRoundOf,new{@id="txtCapacityofBlowerRoundOf",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity of Blower(Cubic m/Sec)</label>
                        @Html.TextBoxFor(c=>c.CapacityofBlowerAfterRoundOup,new{@id="txtCapacityofBlowerRoundOfmpersec",@class="form-control smaller-font smaller-height", style = "width:120px;" ,@readonly="readonly"})
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Velocity(Filter Frame)(m/s)</label>
                        @Html.TextBoxFor(c=>c.VelocityofFilterFrame,new{@id="txtVelocityofFilterFrame",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Filter Area (sq m)</label>
                        @Html.TextBoxFor(c=>c.FilterArea,new{@id="txtFilterArea",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                </div>
                <hr />
                <h6>Exhaust Ducting Details</h6>
                <div class="row">                  
                    <div class="col-md-2">
