                    </td>
                </tr>
            `;
            $('#componentsTable tbody').append(newRow);

            // Clear selections
            $('#drpBendDucting').val('');
            $('#txtDuctLength').val('');
            $('#dicductlength').hide();
        });

        // Handle Delete button click
        $('#componentsTable').on('click', '.delete-row', function () {
            $(this).closest('tr').remove();
            updateRowNumbers(); // Update row numbers after deletion
        });

        // Handle Edit button click
        $('#componentsTable').on('click', '.edit-row', function () {
            const row = $(this).closest('tr');
            const bendType = row.find('.bend-type').text();
            const ductLength = row.find('.duct-length').text();

            // Populate dropdown and input field for editing
            $('#drpBendDucting').val(bendType);
            if (bendType === 'Duct') {
                $('#dicductlength').show();
                $('#txtDuctLength').val(ductLength);
            } else {
                $('#dicductlength').hide();
                $('#txtDuctLength').val('');
            }

            // Remove the row from the table temporarily
            row.remove();
            updateRowNumbers(); // Update row numbers after removal
        });

