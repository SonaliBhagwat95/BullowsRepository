@model Bullows.Model.PaintBoothModel
@{
    ViewData["Title"] = "PaintBooth";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }

    #resultsContainer {
        max-height: 150px;
        overflow-y: auto;
        border: 1px solid #ccc;
        background-color: #f9f9f9;
        padding: 5px;
        margin-top: 5px;
    }

        #resultsContainer div {
            padding: 5px;
            cursor: pointer;
        }

            #resultsContainer div:hover {
                background-color: #eaeaea;
            }

    .input-error {
        border-color: red !important;
    }
</style>

<div class="divPaintBooth" style="margin-left:20px;">
    <form asp-action="SavePaintBoothDetails" asp-controller="PaintBooth" method="post" data-ajax="true" data-ajax-update="divPaintBooth">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="col-lg-12 col-md-12 col-sm-12" id="DivWithImg">
                <div class="row">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-md-3 ">
                                <label class="smaller-font">Enquiry Code</label>
                                @Html.TextBoxFor(c => c.SalesNO, new { @id = "txtEnquiryCode", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                <div id="resultsContainer" class="results-container" style="display: none;"></div>
                            </div>
                            <div class="col-md-2" style="padding-top:15px;">
                                <button type="button" id="searchbtn" class="btn btn-primary rounded-pill" style="width:100px;" disabled>Search</button>
                            </div>
                            <div class="col-md-2" style="padding-top:15px;margin-left:20px;">
                                <button type="button" id="showSettingDetails" class="btn btn-success rounded-pill" style="width:100px;" disabled>Setting</button>
                            </div>
                        </div>
                        <hr />
                        <div class="modal fade" id="settingsModal" tabindex="-1" role="dialog" aria-labelledby="settingsModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="settingsModalLabel">Setting </h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body" id="modalContent">
                                        <!-- Randomized data will be dynamically injected here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="divComponantsdetails">
                            <h6>Components Details</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Depth</label>
                                    @Html.TextBoxFor(c => c.Depth, new { @id = "txtlenght", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                </div>

                                <div class="col-md-3">
                                    <label class="smaller-font">Width</label>
                                    @Html.TextBoxFor(c => c.Width, new { @id = "txtwidth", @class = "form-control  smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Height</label>
                                    @Html.TextBoxFor(c => c.Height, new { @id = "txtheight", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                </div>
                            </div>
                            <hr />
                            <h6>Paint Booth Details</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">D1</label>
                                    @Html.TextBoxFor(c => c.D1, new { @id = "txtD1", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">D2</label>
                                    @Html.TextBoxFor(c => c.D2, new { @id = "txtD2", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">D3</label>
                                    @Html.TextBoxFor(c => c.D3, new { @id = "txtD3", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">W1</label>
                                    @Html.TextBoxFor(c => c.W1, new { @id = "txtw1", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">W2</label>
                                    @Html.TextBoxFor(c => c.W2, new { @id = "txtw2", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">W3</label>
                                    @Html.TextBoxFor(c => c.W3, new { @id = "txtw3", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">H1</label>
                                    @Html.TextBoxFor(c => c.H1, new { @id = "txtH1", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">H2</label>
                                    @Html.TextBoxFor(c => c.H2, new { @id = "txtH2", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Depth(mm)</label>
                                    @Html.TextBoxFor(c => c.D, new { @id = "txtD", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Standard Panels</label>
                                    @Html.TextBoxFor(c => c.StandardPanels, new { @id = "txtstandardPanels", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                </div>
                                <div class="col-md-3">
                                    <label class="smaller-font">Remaining Panels</label>
                                    @Html.TextBoxFor(c => c.RemainingPanels, new { @id = "txtremaingPanels", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                </div>
                            </div> <br />

                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Width(mm)</label>
                                    @Html.TextBoxFor(c => c.W, new { @id = "txtw", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                            
                                    <div class="col-md-3" id="divStandardPanels">
                                        <label class="smaller-font">Standard Panels</label>
                                    @Html.TextBoxFor(c => c.StandardPanelsByW, new { @id = "txtstandardPanelsByW", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-3" id="divRemainingPanels">
                                        <label class="smaller-font">Remaining Panels</label>
                                    @Html.TextBoxFor(c => c.RemainingPanelsByW, new { @id = "txtremaingPanelsByW", @class = "form-control smaller-font smaller-height", style = "width:120px;" ,@readonly = "readonly" })
                                    </div>
                            
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="smaller-font">Height(mm)</label>
                                    @Html.TextBoxFor(c => c.H, new { @id = "txtH", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                                </div>
                                    <div class="col-md-3" id="divStandardPanelsH">
                                        <label class="smaller-font">Standard Panels</label>
                                    @Html.TextBoxFor(c => c.StandardPanelsByH, new { @id = "txtstandardPanelsByH", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-3" id="divRemainingPanelsH">
                                        <label class="smaller-font">Remaining Panels</label>
                                    @Html.TextBoxFor(c => c.RemainingPanelsByH, new { @id = "txtremaingPanelsByH", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                                   
                                    </div>
                                    <div class="col-md-3">
                                    <span id="remainingHeightError" class="text-danger smaller-font" style="display:none;">
                                        Remaining height should be at least 300 mm or set to 0.
                                    </span>
                                    </div>

                            </div>
                           
                        </div>
                    </div>
                    <div class="col-md-5">
                        <img src="~/img/PaintBooth.png" alt="" style="width:200px;height:400px;">
                    </div>
                </div>
            </div>
            <hr />
            <div class="row" id="ServiceDoormainDiv">
                <div class="col-md-4" id="iddivServiceDoor">
                    <lable class="smaller-font">Do you want to added Service Door ?</lable>
                    @Html.CheckBoxFor(c => c.chkServiceDoor, new { @id = "chkServiceDoor" })
                </div>
                <div id="serviceDoorDimentions" class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Service Door Location</label>
                        @Html.DropDownListFor(c => c.ServiceDoorLocation, new List<SelectListItem>
                        {
                        new SelectListItem { Text = "LeftSide", Value = "LeftSide" },
                        new SelectListItem { Text = "RightSide", Value ="RightSide" },
                        new SelectListItem { Text = "Both Side", Value ="Both Side" },
                        }, "--Select--", new { @id = "drpServiceDoorLocation", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                        @Html.ValidationMessageFor(c => c.ServiceDoorLocation, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3" id="iddivServiceDoor">
                        <lable class="smaller-font"> Service Door Height(mm)</lable>
                        @Html.TextBoxFor(c => c.DoorHeight, new { @id = "txtDoorHeight", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3" id="iddivServiceDoor">
                        <lable class="smaller-font">Service Door Width(mm)</lable>
                        @Html.TextBoxFor(c => c.DoorWidth, new { @id = "txtDoorWidth", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>

                </div>
            </div>
            <div id="divBlower">
                <hr />
                <h6>Blower Capacity</h6>
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">C/S Area (sq m)</label>
                        @Html.TextBoxFor(c => c.CrossSectionalArea, new { @id = "txtCrossSectionalArea", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Velocity(Blower)(m/s)</label>
                        @Html.TextBoxFor(c => c.VelocityofBlower, new { @id = "txtVelocityofBlower", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Sec)</label>
                        @Html.TextBoxFor(c => c.CapacityofBlower, new { @id = "txtCapacityofBlower", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Hr)</label>
                        @Html.TextBoxFor(c => c.CapacityofBlowerinH, new { @id = "txtCapacityofBlowerinH", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                </div>
                <hr />
                <h6>Filter Frame Design</h6>
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity (Cubic m/Hr)</label>
                        @Html.TextBoxFor(c => c.CapacityofBlowerinH, new { @id = "txtCapacityofBlowerinHReadonly", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font"> Rounding Up Capacity</label>
                        @Html.TextBoxFor(c => c.CapacityofBlowerRoundOf, new { @id = "txtCapacityofBlowerRoundOf", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Capacity of Blower(Cubic m/Sec)</label>
                        @Html.TextBoxFor(c => c.CapacityofBlowerAfterRoundOup, new { @id = "txtCapacityofBlowerRoundOfmpersec", @class = "form-control smaller-font smaller-height", style = "width:120px;", @readonly = "readonly" })
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-3">
                        <label class="smaller-font">Velocity(Filter Frame)(m/s)</label>
                        @Html.TextBoxFor(c => c.VelocityofFilterFrame, new { @id = "txtVelocityofFilterFrame", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Filter Area (sq m)</label>
                        @Html.TextBoxFor(c => c.FilterArea, new { @id = "txtFilterArea", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                </div>
                <hr />
                <h6>Exhaust Ducting Details</h6>
                <div class="row">
                    <div class="col-md-3">
                        <lable class="smaller-font">Exhaust Duct Height(mm)</lable>
                        @Html.TextBoxFor(c => c.ExhaustDuctHeight, new { @id = "txtexhaustheight", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <lable class="smaller-font">Exhaust Duct Width(mm)</lable>
                        @Html.TextBoxFor(c => c.ExhaustWidth, new { @id = "txtExhaustWidth", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <lable class="smaller-font">Exhaust Duct Thickness(mm)</lable>
                        @Html.TextBoxFor(c => c.ExhaustThickness, new { @id = "txtExhaustThickness", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                        @Html.ValidationMessageFor(c => c.ExhaustThickness, "", new { @class = "text-danger" })
                    </div>
                </div><br />
                <div class="row">

                    <div class="col-md-2">
                        <label class="smaller-font">Blower Orientation</label>
                        @Html.DropDownListFor(c => c.BlowerOrientation, new List<SelectListItem>
                        {
                        // new SelectListItem { Text = "0", Value = "0" },
                        new SelectListItem { Text = "90°", Value ="90" },
                        // new SelectListItem { Text = "180", Value ="180" },
                        // new SelectListItem { Text = "270", Value ="270" },
                        }, new { @id = "drpOrientaionBlower", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })

                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font"> Ducting Component</label>
                        @Html.DropDownListFor(c => c.ExhaustDucting, new List<SelectListItem>{
                                                new SelectListItem { Text = "Bend Upwards", Value = "Bend Upwards", Selected = true },
                        new SelectListItem{Text="Duct",Value="Duct"}
                        }, "--Select--", new { @id = "drpBendDucting", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })

                        @* <select id="drpBendDucting" class="form-control smaller-font smaller-height" style="width: 130px;">
                            <option value="">--Select--</option>
                            <option value="Bend Right">Bend Right</option>
                            <option value="Bend Left">Bend Left</option>
                            <option value="Bend Upwards">Bend Upwards</option>
                            <option value="Bend Downwards">Bend Downwards</option>
                            <option value="Duct">Duct</option>
                        </select> *@
                        @*  @Html.ValidationMessageFor(c => c.ExhaustDucting, "", new { @class = "text-danger" }) *@
                    </div>
                    <div class="col-md-3" id="dicductlength" style="display:none;">
                        <label class="smaller-font">Duct Length(mm)</label>
                        @Html.TextBoxFor(c => c.DuctLength, new { @id = "txtDuctLength", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnAdd" class="btn btn-secondary rounded-pill" style="width:100px; margin-top:10px;">Add</button>
                    </div>


                </div>
                <div class="row" style="margin-top:10px;">

                    <table class="table table-bordered" id="componentsTable">
                        <thead>
                            <tr>
                                <th>Sr. No</th>
                                <th>Bend Type</th>
                                <th>Length</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Rows will be added dynamically -->
                        </tbody>
                    </table>
                    <input type="hidden" id="hiddenDuctingList" name="ExhaustDuctingListJson">
                </div>
                <h6>Blower Power Calculations</h6>
                <div class="row">
                    <div class="col-md-3">
                        <lable class="smaller-font"></lable>
                        <button id="btnWaterColumn" type="button" class="btn btn-secondary rounded-pill" style="margin-top:15px;">Water Column </button>
                    </div>
                    <div class="col-md-12" style="margin-top:10px;">
                        <table id="pressureDropTable" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th style="text-align: center;">Select</th>
                                    <th style="text-align: center;">Item No.</th>
                                    <th style="text-align: center;">Description</th>
                                    <th style="text-align: center;width:80px;">Pressure Drop(mm)</th>
                                    <th style="text-align: center;width:80px;">Quantity</th>
                                    <th style="text-align: center;width:80px;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="pressureDropBody">
                                <!-- Records will be dynamically injected here -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" style="text-align: right;">Addition Factor:</td>
                                    <td><input type="number" value="10" id="additionFactor" class="form-control" style="width: 80px; text-align: center;"></td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="text-align: right; font-weight: bold;">Grand Total:</td>
                                    <td id="grandTotal" style="text-align: center; font-weight: bold;">0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div><hr />

                    <div class="col-md-2">
                        <lable class="smaller-font">Water Column</lable>
                        @Html.ValidationMessageFor(c => c.WaterColumn, "", new { @class = "text-danger" })
                        @Html.TextBoxFor(c => c.WaterColumn, new { @id = "txtWater", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-2">
                        <lable class="smaller-font">Blower Hp calculation</lable>
                        @Html.TextBoxFor(c => c.BlowerHpCalculation, new { @id = "txtHPCalculations", @class = "form-control smaller-font smaller-height", style = "width:120px;" })
                    </div>
                    <div class="col-md-3">
                        <lable class="smaller-font"></lable>
                        <button id="btnFetchRecords" type="button" class="btn btn-secondary rounded-pill" style="margin-top:15px;">Motor Details</button>
                    </div>
                </div><br />
                @*    this code for fetching records for Motor details *@
                <div class="col-md-12">
                    <table id="motorFlangeTable" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Rated Output HP</th>
                                <th>Frame Size</th>
                                <th>Type Reference</th>
                                <th>Rated Speed</th>
                                <th>Rated Current</th>
                                <th>Efficiency Full Load</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="motorFlangeBody">
                            <!-- Records will be injected here by jQuery -->
                        </tbody>
                    </table>
                </div>
                <input type="hidden" id="motorCatalogIDInput" name="MotorCatalogID" />
                <div class=" col-md-12 row" style="margin-top:20px" >
                    <div class="col-md-2">
                        <button type="submit" id="submitbtn" class="btn btn-success rounded-pill" style="width:100px">Next</button>
                    </div>
                    <div class="col-md-10">
                        <span id="SubmitError" class="text-danger smaller-font" style="display:none;">
                            Please check above details are correct or not?
                        </span>
                    </div>
                </div>
            </div>
        </div>
        @if (ViewBag.Message != null)
        {
            <div>
                <span style="color: green;">
                    @ViewBag.Message
                </span>
            </div>
        }
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

      var standardPanelSize ;
      var standardPanelHeight = 2390;
      $(document).ready(function () {
          // Set default values
          $("#submitbtn").prop("disabled", true);
          $("#btnFetchRecords").on("click", function () {
              $("#submitbtn").prop("disabled", false);
          });
          bindSettingstatus();
          $('#motorFlangeTable').hide();
          $('#NonStandardPanel').hide();
          $('#ServiceDoormainDiv').hide();
          $('#serviceDoorDimentions').hide();
          $('#divComponantsdetails').hide();
          $('#divBlower').hide();
          $('#txtD1').val('1200');
          $('#txtD2').val('700');
          $('#txtD3').val('800');
          $('#txtw1').val('500');
          $('#txtw2').val('500');
          $('#txtH1').val('700');
          $('#txtH2').val('1000');
          $('#txtVelocityofBlower').val('0.5');
          $('#txtVelocityofFilterFrame').val('0.5');
          // Check the checkbox
        $("#chkServiceDoor").prop("checked", true);

        // Set dropdown selected value
        $("#drpServiceDoorLocation").val("RightSide");

        // Set textbox values
        $("#txtDoorHeight").val("1180");
        $("#txtDoorWidth").val("580");
          $('#txtDoorWidth, #txtDoorHeight').on('input', function () {
             
              checkServiceDoorHeightAndWidth();
          });

              function checkServiceDoorHeightAndWidth() {

        var D3Width = parseFloat($('#txtD3').val()) || 0;
        var ServiceDoorWidth = parseFloat($('#txtDoorWidth').val()) || 0;
        var ServiceDoorHeight = parseFloat($('#txtDoorHeight').val()) || 0;

        // Reset previous errors
        $('#txtDoorWidth').removeClass('is-invalid');
        $('#txtDoorHeight').removeClass('is-invalid');

        let isValid = true;

        // Width Validation
        if (ServiceDoorWidth > D3Width) {
            $('#txtDoorWidth').addClass('is-invalid');
            alert("Service Door Width cannot be greater than D3 Width (" + D3Width + " mm)");
            isValid = false;
        }

        // Height Validation
        if (ServiceDoorHeight > 2390) {
            $('#txtDoorHeight').addClass('is-invalid');
            alert("Service Door Height cannot be greater than extraction chember height.");
            isValid = false;
        }

        return isValid;
    }





          //this code for changing value for H manually
          // Event listener for changes in txtH
          $('#txtH').on('input', function () {
              isManualChange = true; // Set to true when user changes txtH
          });
          // Event listeners for other input fields to recalculate H
