                  success: function (data) {
                      console.log("Data received: ", data); // Log the full data response

                      if (data.settings && data.settings.length > 0) {
                          var setting = data.settings[0]; // Use the first item in the settings list

                          // Log the setting object to ensure data is accessible
                          console.log("Setting object: ", setting);

                          // Populate the modal with setting data
