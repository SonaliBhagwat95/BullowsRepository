                    </div>
                    <div class="col-md-2">
                        <lable class="smaller-font">Exhaust Width</lable>
                        @Html.TextBoxFor(c=>c.ExhaustWidth,new {@id="txtExhaustWidth",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-2">
                        <lable class="smaller-font">Exhaust Thickness</lable>
                        @Html.TextBoxFor(c=>c.ExhaustThickness ,new {@id="txtExhaustThickness",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                </div>
