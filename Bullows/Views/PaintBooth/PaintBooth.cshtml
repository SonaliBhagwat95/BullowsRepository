    function showMotorDetails() {
        $("#btnFetchRecords").click(function () {
            var blowerHpCalculation = $("#txtHPCalculations").val();

            $.ajax({
                url: '@Url.Action("GetMotorDetails", "PaintBooth")',
                type: 'GET',
                data: { blowerHpCalculation: blowerHpCalculation },
                success: function (data) {
                    var tbody = $("#motorFlangeBody");
                    tbody.empty(); // Clear existing records

                    if (data.length > 0) {
                        $.each(data, function (index, record) {
                            tbody.append(
                                '<tr>' +
                                '<td>' + record.motorCatalogID + '</td>' +
                                '<td>' + record.ratedOutputHP + '</td>' +
                                '<td>' + record.framesize + '</td>' +
                                '<td>' + record.typeReference + '</td>' +
                                '<td>' + record.ratedSpeed + '</td>' +
                                '<td>' + record.ratedCurrent + '</td>' +
                                '<td>' + record.efficiencyFullLoad + '</td>' +
                                '<td><input type="radio" class="form-check-input select-radio" data-id="' + record.motorCatalogID + '" name="motorSelection"></td>' +
                                '</tr>'
                            );
                        });
                    } else {
                        tbody.append('<tr><td colspan="6">No records found</td></tr>');
                    }
                    bindRadioChange(); // Bind the change event after data is loaded
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching records: ", error);
                }
            });
        });
    }

    // Function to bind the radio button change event
    function bindRadioChange() {
        $('.select-radio').change(function () {
            var selectedMotorID = $(this).data('id');
            $("#motorCatalogIDInput").val(selectedMotorID); // Set the selected motor ID in the hidden input
        });
    }

   
   
