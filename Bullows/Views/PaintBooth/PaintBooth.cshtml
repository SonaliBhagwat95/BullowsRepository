    function calculateFilterFrame() {
       
        var roundedValue = parseFloat($('#txtCapacityofBlowerRoundOfmpersec').val()) || 0;
        console.log("roundedValue", roundedValue);
        // Get the original blower capacity value
        var originalValue = parseFloat($('#txtCapacityofBlower').val()) || 0;

        // Determine which value to use: rounded if it's greater than 0, otherwise original
        var Capacity = roundedValue > 0 ? roundedValue : originalValue;
        console.log("Capacity", Capacity);

        // Get the velocity of the filter frame
        var Velocityoffilter = parseFloat($('#txtVelocityofFilterFrame').val()) || 0;

        // Calculate the total filter area
