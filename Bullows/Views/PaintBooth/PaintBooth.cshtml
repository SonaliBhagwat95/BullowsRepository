    function bindSettingstatus() {
        $('#txtEnquiryCode').on('keyup', function () {
            var enquiryCode = $(this).val().trim().toLowerCase(); // Trim and convert to lowercase

            if (enquiryCode.length > 0) {
                $.ajax({
                    url: '@Url.Action("SearchEnquiryCode", "PaintBooth")',
                    type: 'POST',
                    data: { enquiryCode: enquiryCode },
                    success: function (data) {
                        $('#resultsContainer').empty();

                        if (data.success && data.results.length > 0) {
                            var resultsHtml = '';
                            data.results.forEach(function (item) {
                                resultsHtml += '<div class="result-item">' + item + '</div>';
                            });
                            $('#resultsContainer').html(resultsHtml).show();
                        } else {
                            $('#resultsContainer').html('<div>Enquiry Code does not Available</div>').show();
                        }
                    },
                    error: function () {
                        $('#resultsContainer').empty().html('<div>Error occurred while searching.</div>').show();
                    }
                });
            } else {
                $('#resultsContainer').empty().hide(); // Hide the container when input is empty
            }
        });

        // Handle result selection
        $(document).on('click', '#resultsContainer div', function () {
            var selectedCode = $(this).text();
            console.log("selectedCode", selectedCode);
            $('#txtEnquiryCode').val(selectedCode);

            $('#resultsContainer').empty().hide(); // Hide the container after selection
            $('#searchbtn').prop('disabled', false);
        });

        // Handle next button click
        $(document).on('click', '#btnNext', function () {
            window.location.href = '@Url.Action("BOCalculations", "Costing")';
        });
    }
    function showSettingDetails() {
        $('#showSettingDetails').click(function () {
            var enquiryCode = $('#txtEnquiryCode').val(); // Get the enquiry code from the textbox
            $.ajax({
                url: '@Url.Action("GetSettingDetailsByCode", "PaintBooth")', // Adjust the controller name
                type: 'GET',
                data: { enquiryCode: enquiryCode }, // Pass the enquiry code
                success: function (data) {
                    console.log("Data received: ", data); // Log the full data response

                    if (data.settings && data.settings.length > 0) {
                        var setting = data.settings[0]; // Use the first item in the settings list

                        // Log the setting object to ensure data is accessible
                        console.log("Setting object: ", setting);

                        // Populate the modal with setting data
                        var content = `
                    <table class="table table-striped">
                        <tbody>
                            <tr>
                                <th>Sales No</th>
                                <td>${setting.salesNo}</td>
                            </tr>
                            <tr>
                                <th>Panel Width</th>
                                <td>${setting.panelWidth}</td>
                            </tr>
                            <tr>
                                <th>Panel Height</th>
                                <td>${setting.panelHeight}</td>
                            </tr>
                            <tr>
                                <th>Sheet Thickness</th>
                                <td>${setting.sheetThickness}</td>
                            </tr>
                            <tr>
                                <th>Slot Dimension</th>
                                <td>${setting.slotDimention}</td>
                            </tr>
                            <tr>
                                <th>Standard Bend 1</th>
                                <td>${setting.standardBend1}</td>
                            </tr>
                            <tr>
                                <th>Standard Bend 2</th>
                                <td>${setting.standardBend2}</td>
                            </tr>
                            <tr>
                                <th>Materials</th>
                                <td>${setting.materials}</td>
                            </tr>
                            <tr>
                                <th>H</th>
                                <td>${setting.h}</td>
                            </tr>
                            <tr>
                                <th>W</th>
                                <td>${setting.w}</td>
                            </tr>
                            <tr>
                                <th>T</th>
                                <td>${setting.t}</td>
                            </tr>
                            <tr>
                                <th>Pitch Distance</th>
                                <td>${setting.pitchDistance}</td>
                            </tr>
                            <tr>
                                <th>Section</th>
                                <td>${setting.section}</td>
                            </tr>
                        </tbody>
                    </table>
                `;
                        // Inject the content into the modal
                        $('#modalContent').html(content);

                        // Show the modal
                        $('#settingsModal').modal('show');
                    } else {
                        // Log if no settings are found
                        console.log("No settings found for the provided enquiry code.");

                        // Show a message in the modal
                        $('#modalContent').html('<p>No settings found for the provided enquiry code.</p>');
                        $('#settingsModal').modal('show');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching data: " + error); // Log any errors
                }
            });

            $(document).on('click', '.close', function () {
                $('#settingsModal').modal('hide'); // Explicitly hide the modal
            });
        });
    }
   


