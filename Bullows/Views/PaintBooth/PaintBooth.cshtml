    function updateDropdownOptions(standardPanels) {
        // Clear previous dropdown options
        var dropdown = $('#panelSizeDropdownforW');
        var currentValue = dropdown.val(); // Get the currently selected value

        dropdown.empty(); // Clear existing options
       

        // Define all dropdown options
        var options = [
            { Text: "1", Value: "1" },
            // { Text: "1.5", Value: "2" },
            { Text: "2", Value: "3" },
            // { Text: "2.5", Value: "4" },
            { Text: "3", Value: "5" },
            // { Text: "3.5", Value: "6" },
            { Text: "4", Value: "7" },
            // { Text: "4.5", Value: "8" },
            { Text: "5", Value: "9" },
            // { Text: "5.5", Value: "10" },
            { Text: "6", Value: "11" },
            // { Text: "6.5", Value: "12" },
            { Text: "7", Value: "13" },
            // { Text: "7.5", Value: "14" }
        ];

        
        let newOptions;
        if (standardPanels === 1) {
            // Add first 3 options
            newOptions = options.slice(0, 2); // "1", "1.5", "2"
        } else if (standardPanels === 2) {
            // Add options for standardPanels equal to 2
            newOptions = options.slice(1, 3); // "2", "2.5", "3"
        } else if (standardPanels === 3) {
            // Add options for standardPanels equal to 3
            newOptions = options.slice(2, 4); // "3.5", "4", "4.5"
        } else if (standardPanels === 4) {
            // Add options for standardPanels equal to 4
            newOptions = options.slice(3, 5); // "5", "5.5", "6"
        } else {
            // Add all remaining options if standardPanels is larger
            newOptions = options.slice(11); // "6.5", "7", "7.5"
        }

        // Add new options to the dropdown
        addOptionsToDropdown(dropdown, newOptions);

        // Set the previously selected value, if it's still available in the new options
        if (newOptions.some(option => option.Value === currentValue)) {
            dropdown.val(currentValue); // Re-select the previous value
        } else {
            dropdown.val(''); // Reset the value if the previous option is not available
        }
        
    }
    // Helper function to add options to the dropdown
    function addOptionsToDropdown(dropdown, options) {
        options.forEach(function (option) {
            dropdown.append($('<option>', {
                value: option.Value,
                text: option.Text
            }));
        });
    }
