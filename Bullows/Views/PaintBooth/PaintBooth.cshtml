                            <thead>
                                <tr>
                                    <th style="text-align: center;">Select</th>
                                    <th style="text-align: center;">Item No.</th>
                                    <th style="text-align: center;">Description</th>
                                    <th style="text-align: center;width:80px;">Pressure Drop(mm)</th>
                                    <th style="text-align: center;width:80px;">Quantity</th>
                                    <th style="text-align: center;width:80px;">Total</th>
                                </tr>
                            </thead>
                            <tbody id="pressureDropBody">
                                <!-- Records will be dynamically injected here -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" style="text-align: right;">Addition Factor:</td>
                                    <td><input type="number" id="additionFactor" class="form-control" style="width: 80px; text-align: center;"></td>
                                </tr>
                                <tr>
                                    <td colspan="5" style="text-align: right; font-weight: bold;">Grand Total:</td>
                                    <td id="grandTotal" style="text-align: center; font-weight: bold;">0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div><hr/>
                   
                    <div class="col-md-2">
                        <lable class="smaller-font">Water Column</lable>
                        @Html.ValidationMessageFor(c => c.WaterColumn, "", new { @class = "text-danger" })
                        @Html.TextBoxFor(c=>c.WaterColumn,new{@id="txtWater",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                    </div>
                    <div class="col-md-2">
                        <lable class="smaller-font">Blower Hp calculation</lable>
                        @Html.TextBoxFor(c=>c.BlowerHpCalculation,new{@id="txtHPCalculations",@class="form-control smaller-font smaller-height", style = "width:120px;"})
                        
                    </div>
                    <div class="col-md-3">
                        <label class="smaller-font">Blower Orientation</label>
                        @Html.DropDownListFor(c => c.BlowerOrientation, new List<SelectListItem>
                        {
                        new SelectListItem { Text = "0", Value = "0" },
                        new SelectListItem { Text = "90", Value ="90" },
                        new SelectListItem { Text = "180", Value ="180" },
                        new SelectListItem { Text = "270", Value ="270" },
                        },  new { @id = "drpOrientaionBlower", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                        
                    </div>

                    <div class="col-md-3">
                        <lable class="smaller-font"></lable>
                        <button id="btnFetchRecords" type="button" class="btn btn-secondary rounded-pill" style="margin-top:15px;">Motor Details</button>
                    </div>
                </div><br/>
             @*    this code for fetching records for Motor details *@
                <div class="col-md-12">
                    <table id="motorFlangeTable" class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Rated Output HP</th>
                                <th>Frame Size</th>
                                <th>Type Reference</th>
                                <th>Rated Speed</th>
                                <th>Rated Current</th>
                                <th>Efficiency Full Load</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="motorFlangeBody">
                            <!-- Records will be injected here by jQuery -->
                        </tbody>
                    </table>
                </div>
                <input type="hidden" id="motorCatalogIDInput" name="MotorCatalogID" />
                <div class="row" style="margin-top:20px">
                    <div class="col-md-2">
                        <button type="submit" id="submitbtn" class="btn btn-success rounded-pill" style="width:100px">Next</button>
                    </div>                  
                </div>
            </div>
        </div>
        @if (ViewBag.Message != null)
        {
            <div>
                <span style="color: green;">
                    @ViewBag.Message
                </span>
            </div>
