                    console.error(xhr.responseText);
                }
            });

            // Handle enquiry code suggestions
            $('#txtEnquiryCode').on('input', function () {
                var enquiryCode = $(this).val();

                if (enquiryCode.trim() === '') {
                    $('#resultsContainer').hide().empty();
                    $('#searchbtn').prop('disabled', true);
                    return;
                }

                $.ajax({
                    url: '/PaintBooth/SearchEnquiryCode',
                    type: 'POST',
                    dataType: 'json',
                    data: { enquiryCode: enquiryCode },
                    success: function (response) {
                        if (!response.success || response.results.length === 0) {
                            $('#resultsContainer').show().html('<p>No Enquiry Codes found</p>');
                            $('#searchbtn').prop('disabled', true);
                            return;
                        }

                        var resultsHtml = '<ul>';
                        response.results.forEach(function (result) {
                            resultsHtml += `<li class="result-item" data-code="${result}">${result}</li>`;
                        });
                        resultsHtml += '</ul>';

                        $('#resultsContainer').show().html(resultsHtml);
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            });

            $(document).on('click', '.result-item', function () {
                var selectedCode = $(this).data('code');
                $('#txtEnquiryCode').val(selectedCode);
                $('#resultsContainer').empty();
                $('#searchbtn').prop('disabled', false);
            });
