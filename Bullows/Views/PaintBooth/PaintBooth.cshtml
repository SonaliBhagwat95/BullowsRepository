              var squareRootValue = Math.sqrt(capacityinmeter);

              var valueInMM = Math.ceil(squareRootValue * 1000);

              // Step 3: Update the values in Exhaust Duct Height and Width
              $("#txtexhaustheight").val(valueInMM.toFixed(2));
              $("#txtExhaustWidth").val(valueInMM.toFixed(2));
