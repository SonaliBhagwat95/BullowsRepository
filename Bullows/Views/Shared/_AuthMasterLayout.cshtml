@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Boxicons CSS -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <title>@ViewBag.Title - Bullows</title>
    <link rel="stylesheet" href="~/css/sidebar/style.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @*<link href="~/css/fontawesome/font-awesome.min.css" rel="stylesheet" />*@    

    <style>
        .active {
            background-color: #8488db;
            color: white;
        }
    </style>
</head>
<body class="body-full-height" style="margin-top: 1px; background-image: linear-gradient(to right, #2B3F4B 16.7%,#EEEEEE 10%,#EEEEEE 80%)">
    <!-- navbar -->
    <nav class="navbar sticky-top">
        <div>

            <img src="~/img/logo.png" alt="" style="width:100%;height:35px;border-radius:unset">
        </div>

        <div class="search_bar" style="height:unset;">
           
        </div>

        <div class="navbar_content" style="column-gap:unset">
               
            <span class="xn-text" style="color:black;margin-left:-10%"> @HttpContextAccessor.HttpContext.Session.GetString("UserName")</span>
            <a href="@Url.Action("LogIn", "LogOn")" title="Log Out">
                <img alt=" " src="~/img/logout.jpg" style="width:25px;height:25px">
            </a>
        </div>

    </nav>

    <div class="row">
        <!-- sidebar -->
        <div class="col-md-2">
            <nav class="sidebar">
                <div class="menu_content">
                    <ul class="menu_items">
                        @*  <li class="item"> *@
                        @if (HttpContextAccessor.HttpContext.Session.GetInt32("UserRoleId") == 1){

                      
                        <li class="item @(ViewBag.ActivePage == "Home" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                    <span href="~/Home/Dashboard">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/Home/Dashboard" style="color:black;font-size:small;padding-left:-1%">Home</a>
                            </div>
                        </li>
                        <li class="item @(ViewBag.ActivePage == "Enquiry" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <span href="~/enquiry/enquiry">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/enquiry/enquiry" style="color:black;font-size:small;padding-left:-1%">Enquiry</a>
                            </div>
                        </li>
                        <li class="item @(ViewBag.ActivePage == "PanelSetting" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <span href="~/PanelSetting/PanelSetting">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/PanelSetting/PanelSetting" style="color:black;font-size:small;padding-left:-1%">Setting</a>
                            </div>
                        </li>
                        <li class="item @(ViewBag.ActivePage == "PaintBooth" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <i class="bx bx-grid-alt"></i>
                                <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/paintbooth/paintbooth"> Paintbooth Design</a>
                            </div>
                        </li>
                        <li class="item @(ViewBag.ActivePage == "Raw Material Costing" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <i class="bx bx-grid-alt"></i>
                                <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/Costing/Costing"> Raw Material Costing</a>
                            </div>
                        </li>
                            <li class="item @(ViewBag.ActivePage == "BO Calculations" ? "active" : "")">
                                <div class="nav_link submenu_item">
                                    <i class="bx bx-grid-alt"></i>
                                    <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/Costing/BOCalculations">BO Calculations</a>
                                </div>
                            </li>
                        <li class="item @(ViewBag.ActivePage == "PriceBID" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <span href="~/Costing/PriceBID">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/Costing/PriceBID" style="color:black;font-size:small;padding-left:-1%">Price BID</a>
                            </div>
                        </li>
                        <li class="item @(ViewBag.ActivePage == "ProposalForm" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <span href="~/Costing/ProposalForm">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/Costing/ProposalForm" style="color:black;font-size:small;padding-left:-1%">Proposal Approval</a>
                            </div>
                        </li>

                        <li class="item @(ViewBag.ActivePage == "Project" ? "active" : "")">
                            <div class="nav_link submenu_item">
                                <span href="~/project/project">
                                    <i class="bx bx-grid-alt"></i>
                                </span>
                                <a class="nav-link content-font" href="~/project/project" style="color:black;font-size:small;padding-left:-1%">Project</a>
                            </div>
                        </li>
                            <li class="item @(ViewBag.ActivePage == "Customer" ? "active" : "")">
                                <div class="nav_link submenu_item">
                                    <span href="~/ customer/customer">
                                        <i class="bx bx-grid-alt"></i>
                                    </span>
                                    <a class="nav-link content-font" href="~/customer/customer" style="color:black;font-size:small;padding-left:-1%">Customer Details</a>
                                </div>
                            </li>
                            <li class="item @(ViewBag.ActivePage == "Material" ? "active" : "")">
                                <div class="nav_link submenu_item">
                                    <i class="bx bx-grid-alt"></i>
                                    <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/Costing/Material">Material</a>
                                </div>
                            </li>
                        }
                        else if (HttpContextAccessor.HttpContext.Session.GetInt32("UserRoleId") == 3)                           
                        {
                                <li class="item @(ViewBag.ActivePage == "PanelInput" ? "active" : "")">
                                    <div class="nav_link submenu_item">
                                        <i class="bx bx-grid-alt"></i>
                                        <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/PanelInput/PanelInput"> PanelInput Design</a>
                                    </div>
                                </li>
                                <li class="item @(ViewBag.ActivePage == "BendSection" ? "active" : "")">
                                    <div class="nav_link submenu_item">
                                        <i class="bx bx-grid-alt"></i>
                                        <a class="nav-link content-font" style="color:black;font-size:small;padding-left:-1%" href="~/BendSection/BendSection">Bend Section</a>
                                    </div>
                                </li>
                            
                        }
                    </ul>


                    <!-- Sidebar Open / Close -->
                    <div class="bottom_content">
                        <div class="bottom expand_sidebar">
                            
                        </div>
                        
                    </div>
                </div>
            </nav>
        </div>
        <div class="container">
            <div class="col-md-10" style="width:100%">
                @*<main role="main" class="pb-3">*@
                <div class="panel-body" style="margin:2% 0 0 22%">
                    <div class="panel-heading-style" style="color:blue">
                        @ViewBag.headerText

                    </div>
                    <br />
                    @RenderBody()
                    <div style="color:green;padding-right:10%">@ViewBag.SuccessText</div>
                    <div style="color:red;margin-left:2%;font-size:14px"> @ViewBag.ErrorText </div>
                </div>
                @*</main>*@
            </div>
        </div>
    </div>
    <!-- JavaScript -->
    @*  <script src="~css/sidebar/script.js"></script> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
