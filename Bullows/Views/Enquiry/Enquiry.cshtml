    let uploadedFiles = [];

    // Handle file uploads
    function handleFileUpload() {
        const fileInput = $('#imageFileInput')[0];
        const newFiles = Array.from(fileInput.files);

        // Append new files to the existing array
        uploadedFiles = uploadedFiles.concat(newFiles);

        // Enable the "Show Uploaded Files" button if there are uploaded files
        $('#showFilesButton').prop('disabled', uploadedFiles.length === 0);

        // Show the uploaded files in the modal
        showUploadedFiles();
    }

    // Show uploaded files in the modal
    function showUploadedFiles() {
        const fileList = $('#uploadedFilesList');
        fileList.empty(); // Clear the existing list

        $.each(uploadedFiles, function (index, file) {
            const listItem = $('<li></li>');

            // Create a link for the file name that enables download
            const fileLink = $('<a></a>')
                .attr('href', URL.createObjectURL(file))
                .attr('download', file.name)
                .text(file.name);

            listItem.append(fileLink);
            fileList.append(listItem);
        });
    }

    // Download all uploaded files
    function downloadAllFiles() {
        $.each(uploadedFiles, function (index, file) {
            const url = URL.createObjectURL(file);
            const a = $('<a></a>')
                .attr('href', url)
                .attr('download', file.name);
            $('body').append(a);
            a[0].click();
            a.remove();
        });
    }

