@model Bullows.Model.EnquiryModel
@{
    ViewData["Title"] = "Enquiry";
    Layout = "~/Views/Shared/_AuthMasterLayout.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">


<style>
    .smaller-font, .smaller-font input {
        font-size: smaller;
    }

    .smaller-height {
        height: 30px;
    }
</style>

<div class="divPanel">
    <form asp-action="SaveEnquiryDetails" asp-controller="Enquiry" method="post" data-ajax="true" data-ajax-update="divPanel" enctype="multipart/form-data">
        <div class="row cl-md-12 col-lg-12 col-sm-12 ">
            <div class="row">
                @Html.HiddenFor(c=>c.EmailId)
                @Html.HiddenFor(c=>c.CustomerID)
                @Html.HiddenFor(c=>c.EnquiryId)
                <div class="col-md-3">
                    <label class="smaller-font">Proposal Date</label>
                    @Html.TextBoxFor(c => c.ProposalDate,"{0:yyyy-MM-dd}", new {@id="txtpdateid",@type="date", @class = "form-control smaller-font smaller-height", style = "width: 130px;"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Enquiry NO</label>
                    @Html.TextBoxFor(c => c.SalesNO, new {@id="txtsalesid", @class = "form-control smaller-font smaller-height", style = "width: 130px;"})
                    <span id="enquiryNoValidationMessage" class="text-danger" style="display:none;">This Enquiry No is already in use, please enter another one.</span>
                </div>
            </div>
        </div>
        <hr />
        <h6>Company Details</h6>
        <div class=" cl-md-12 col-lg-12 col-sm-12 ">
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">Company Name</label>
                    @Html.TextBoxFor(c => c.CompanyName, new{@id="txtcname",@class = "form-control smaller-font smaller-height",style="width:130px"})
                    <div id="company-list" class="dropdown-menu" style="width: 130px; position: absolute; z-index: 1000;"></div>
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Address</label>
                    @Html.TextBoxFor(c => c.CustomerAddress,new {@id="txtcadresss",@class = "form-control smaller-font smaller-height",style="width:130px", @readonly="readonly"})
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">Contact Person</label>
                    @Html.TextBoxFor(c=>c.Contactperson ,new {@id="txtContactPerson",@class="form-control smaller-font smaller-height",style="width:130px",@readonly="readonly"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Designation</label>
                    @Html.TextBoxFor(c => c.Designation,new {@id="txtdesignation",@class = "form-control smaller-font smaller-height",style="width:130px",@readonly="readonly"})
                </div>
                <div class="col-md-3">
                    <label>Mobile No</label>
                    @Html.TextBoxFor(c => c.MobileNo,new {@id="txtmobile",@class = "form-control smaller-font smaller-height",style="width:130px",@readonly="readonly"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Email ID</label>
                    @Html.TextBoxFor(c => c.EmailId,new {@id="txtemail",@class = "form-control smaller-font smaller-height",style="width:130px",@readonly="readonly"})
                </div>
            </div>
        </div>
        <hr />
        <h6>Basis of Design</h6>
        <div class="cl-md-12 col-lg-12 col-sm-12">
            <div class="row">

                <div class="col-md-3">
                    <label class="smaller-font">Component Name</label>
                    @Html.TextBoxFor(c =>c.Component,new{@id="txtcomponent",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Construction</label>
                    @Html.TextBoxFor(c =>c.MaterialofConstruction,new{@id="txtmoconSTD",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Upload Drawings/Attachments</label>
                    <input type="file" name="imageFile" id="imageFileInput" multiple onchange="handleFileUpload()" />
                </div>

                <!-- Modal to Show Uploaded Files -->
                <div class="modal fade" id="uploadedFilesModal" tabindex="-1" role="dialog" aria-labelledby="uploadedFilesLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="uploadedFilesLabel">Uploaded Files</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <ul id="uploadedFilesList"></ul>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                <button type="button" class="btn btn-primary" onclick="downloadAllFiles()">Download All Files</button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Button to trigger modal, initially disabled -->
                <button type="button" class="btn btn-success rounded-pill" id="showFilesButton" data-toggle="modal" style="width:150px;height:35px;font-size: 12px;margin-top:10px;" data-target="#uploadedFilesModal" disabled>
                    Show Uploaded Files
                </button>

            </div>
            <br />
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">Shape</label>
                    @Html.DropDownListFor(c => c.Shape, new List<SelectListItem>
                    {
                    new SelectListItem { Text = "Rectangular", Value = "Rectangular" },
                    new SelectListItem { Text = "Circular", Value ="Circular" },
                    }, "--Select--", new { @id = "drpShape", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Orientation</label>
                    @Html.DropDownListFor(c => c.Orientation, new List<SelectListItem>
                    {
                    new SelectListItem { Text = "Horizontal", Value = "Horizontal" },
                    new SelectListItem { Text = "Vertical", Value ="Vertical" },
                    }, "--Select--", new { @id = "drpOrientation", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                </div>
            </div><br />
            <div class="row" id="rectangular-section"  style="display:none;">
                           
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="smaller-font">Depth(mm)</label>
                        @Html.TextBoxFor(c => c.LengthSize, new { @id = "txtLengthSize", @class = "form-control smaller-font smaller-height", style = "width:130px;" })
                    </div><br />
                    <div class="form-group">
                        <label class="smaller-font">Width(mm)</label>
                        @Html.TextBoxFor(c => c.WidthSize, new { @id = "txtWidthSize", @class = "form-control smaller-font smaller-height", style = "width:130px;" })
                    </div><br />
                    <div class="form-group">
                        <label class="smaller-font">Height(mm)</label>
                        @Html.TextBoxFor(c => c.HeightSize, new { @id = "txtHeightSize", @class = "form-control smaller-font smaller-height", style = "width:130px;" })
                    </div>
                </div>
               
                <div class="col-md-8">
                    <div class="row">
                        <div class="col-md-6" >
                            <div class="form-group" id="Horizontalrectangle">
                                <img src="~/img/Rectangular.PNG" alt="Rectangular" style="width:250px;height:200px;">
                            </div>
                            <div class="form-group" id="verticalrectangle">
                                <img src="~/img/VerticalRectangular.PNG" alt="VerticalRectangular" style="width:250px;height:200px;">
                            </div>
                        </div>                   
                     </div>
            </div>
            </div>
          @*   Circular shape *@
            <div id="circular-section" class="row" style="display:none;">               
                <div class="col-md-4">
                    <div class="col-md-3">
                        <label class="smaller-font">Diameter(mm)</label>
                        @Html.TextBoxFor(c => c.Diameter, new { @id = "txtDiameter", @class = "form-control smaller-font smaller-height", style = "width:130px;" })
                    </div><br/>
                    <div class="col-md-3">
                        <label class="smaller-font">Height(mm)</label>
                        @Html.TextBoxFor(c => c.CircularHeightSize, new { @id = "txtHeightSizeCircular", @class = "form-control smaller-font smaller-height", style = "width:130px;" })
                    </div>
                </div>
                @* <div class="col-md-6">
                    <div class="col-md-3" id="VerticalCircle">
                        <img src="~/img/Circular.PNG" alt="Circular" style="width:190px;height:150px;">
                    </div>
                    <div class="form-group" id="HorizonatalCircle">
                        <img src="~/img/HorizontalCircular.PNG" alt="HorizonatalCircle" style="width:250px;height:200px;">
                    </div>
                </div> *@

                <div class="col-md-6">
                    <div class="form-group" id="VerticalCircle">
                        <img src="~/img/Circular.PNG" alt="Vertical Circular" style="width:190px;height:150px;">
                    </div>
                    <div class="form-group" id="HorizonatalCircle">
                        <img src="~/img/HorizontalCircular.PNG" alt="Horizontal Circular" style="width:190px;height:150px;">
                    </div>
                </div>
            </div>                    
            <br />
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">Weight(kg)</label>
                    @Html.TextBoxFor(c =>c.Weight,new{@id="txtWeight",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Surface Area(Sq.mtr)</label>
                    @Html.TextBoxFor(c =>c.SurfaceArea,new{@id="txtsurfacearea",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Wall Thickness(mm)</label>
                    @Html.TextBoxFor(c => c.WallThickness ,new{@id="txtwallthickness",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>

                <div class="col-md-3">
                    <label class="smaller-font">Viscosity(Sec)</label>
                    @Html.TextBoxFor(c =>c.Viscosity,new{@id="txtmoconSTD",@class = "form-control smaller-font smaller-height",style="width:130px;"})
                </div>
            </div><br />
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">.</label><br />
                    <input type="radio" name="Consumption" value="Paint" @(Model.Consumption == "Paint" ? "checked='checked'" : "") />&nbsp;&nbsp;&nbsp<span style="font-size:small">Paint</span>
                    <input type="radio" name="Consumption" value="Powder" @(Model.Consumption == "Powder" ? "checked='checked'" : "") />&nbsp;&nbsp;<span style="font-size:small">Powder</span>
                </div>
                <div class=" paint col-md-3">
                    <label class="smaller-font">Paint(ltr)</label>
                    @Html.TextBoxFor(c => c.Paint ,new{@id="txtpaint",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class=" Powder col-md-3">
                    <label class="smaller-font">Powder(kg)</label>
                    @Html.TextBoxFor(c => c.Powder ,new{@id="txtPowder",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label for="CategoryDropdown" class="smaller-font">PaintBooth Type</label>
                    @Html.DropDownListFor(c => c.Category, new List<SelectListItem>{
                        new SelectListItem {Text = "Dry Paint Booth", Value="1"},
                    new SelectListItem {Text = "Wet Paint Booth", Value="2"},
                    }, "--Select--",
                    new { @id = "Category", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">DFT(micron)</label>
                    @Html.TextBoxFor(c => c.DFT ,new{@id="txtwallthickness",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>             
            </div><br />

            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">No of Colours</label>
                    @Html.TextBoxFor(c =>c.NoOfColors,new{@id="txtWeight",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">No of coats</label>
                    @Html.TextBoxFor(c =>c.NoOfCoats,new{@id="txtmoconSTD",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-4">
                    <label class="smaller-font">Specific heat of component(kcal/hr)</label>
                    @Html.TextBoxFor(c =>c.SpecificHeat,new{@id="txtsurfacearea" ,@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>

            </div>
           <br/>                  
            <div class="row">
                <!-- Component Handling Dropdown -->
                <div class="col-md-3">
                    <label class="smaller-font">Component handling</label>
                    @Html.DropDownListFor(c => c.ComponentHandling, new List<SelectListItem>
                    {
                    new SelectListItem { Text = "Applicable", Value = "1" },
                    new SelectListItem { Text = "Not-Applicable", Value ="2" },
                    }, "--Select--", new { @id = "drpCpmonenthandling", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
                </div>                  
                    <div class="Conveyor col-md-3" id="drpConveyordiv">
                        <label class="smaller-font">Conveyor Types</label>
                        @Html.DropDownListFor(c=> c.Conveyor ,new List<SelectListItem>
                        {
                        new SelectListItem{Text="EOT Crane",Value="1"},
                        new SelectListItem{Text="Hoist",Value="2"},
                        new SelectListItem{Text="Overhead Conveyor",Value="3"},
                        new SelectListItem{Text="Four Wheel (Biplanar)",Value="4"},
                        new SelectListItem{Text="Overhead Manual Push Pull Track & Trolley Conveyor",Value="5"},
                        new SelectListItem{Text="Motorized Floor Conveyor",Value="6"},
                        new SelectListItem{Text="Motorized Floor Trolley",Value="7"},
                        new SelectListItem{Text="Manually Push Pull Trolley",Value="8"},
                        }, "--Select--", new { @id="drpConveyor", @class = "form-control smaller-font smaller-height", style="width:130px;" })
                    </div>
                <div class="col-md-3" id="drpOverheadConverSubTypes">
                    <label class="smaller-font">Conveyor SubTypes</label>
                    @Html.DropDownListFor(c=> c.OverheadConveyorSubTypes ,new List<SelectListItem>
                    {
                    new SelectListItem{Text="Continous",Value="1"},
                    new SelectListItem{Text="Stop & Go",Value="2"},                   
                    }, "--Select--", new { @id="drpOverheadConveyorsub", @class = "form-control smaller-font smaller-height", style="width:130px;" })
                </div>

                <div class="Pitch col-md-3" id="txtCarryCapacitydiv">
                        <label class="smaller-font">Carrying Capacity(Kg)</label>
                        @Html.TextBoxFor(c => c.CarringCapacity, new { @id="txtCarryCapacity", @class = "form-control smaller-font smaller-height", style="width:130px;" })
                </div>

                <div class="col-md-3" id="drpConveyorNumberdiv">
                        <label class="smaller-font">Conveyor Number</label>
                        @Html.DropDownListFor(c => c.ConveyorNumber ,new List<SelectListItem>
                        {
                        new SelectListItem{Text="348",Value="1"},
                        new SelectListItem{Text="458",Value="2"},
                        new SelectListItem{Text="678",Value="3"},
                        }, "--Select--", new { @id="drpConveyorNumber", @class = "form-control smaller-font smaller-height", style="width:130px;" })
                    </div> 
            </div>
            <br />
            <div class="row">
                <div class="col-md-3" id="divPitch" style="display:none;">
                    <label class="smaller-font">Pitch(mm)</label>
                    @Html.TextBoxFor(c => c.Pitch, new { @id="txtPitch", @class = "form-control smaller-font smaller-height", style="width:130px;" })
                </div>
                <div class="col-md-3" id="divSpeed" style="display:none;">
                    <lable class="smaller-font">Speed(m/min)</lable>
                    @Html.TextBoxFor(c => c.Speed,new{@id="txtSpeed",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Loading & Unloading </label>
                    @Html.DropDownListFor(c=> c.LoadingUnloading ,new List<SelectListItem>
                    {
                    new SelectListItem{Text="Manual",Value="Manual"},
                    new SelectListItem{Text="Automatic",Value="Automatic"},

                    },"Select",new {@id="drpLoadingUnloading",@class = "form-control smaller-font smaller-height",style="width:130px;"})
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <label class="smaller-font">Production/Shift </label>
                    @Html.TextBoxFor(c => c.ProductionRequirement,new{@id="txtproreuirement",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Working days/year</label>
                    @Html.TextBoxFor(c => c.Workingdays,new{@id="txtworkday",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">No.of Shifts/day</label>
                    @Html.TextBoxFor(c => c.NumberofShifts,new{@id="txtnumofshifts",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
                <div class="col-md-3">
                    <label class="smaller-font">Effective Working Hrs</label>
                    @Html.TextBoxFor(c=>c.EffectiveWorking,new{@id="txteeffworking",@class = "form-control smaller-font smaller-height",style="width:130px"})
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-3">
                <label for="CategoryDropdown" class="smaller-font">Paint Booth SubType:</label>
                @Html.DropDownListFor(c => c.PaintBoothType, new List<SelectListItem>{
                new SelectListItem {Text = "Open", Value="1"},
                new SelectListItem {Text = "Enclosed", Value="2"},
                new SelectListItem {Text = "Positive Pressurized", Value="3"},
                new SelectListItem {Text = "Negative Pressurized", Value="4"},
                }, "--Select--",
                new { @id = "drpPaintBoothType", @class = "form-control smaller-font smaller-height", style = "width: 130px;" })
            </div>

            <div class="col-md-3">
              <label class="smaller-font"> Motor Type</label>
              @Html.DropDownListFor(c=>c.MotorType,new List<SelectListItem>{
                  new SelectListItem{Text="NLP", Value="NLP"},
                  new SelectListItem{Text="FLP",Value="FLP"}
              },"---Select---",
                new {@id="drpMotorType",@class = "form-control smaller-font smaller-height", style = "width: 130px;" })
            </div>
           
        </div>
        <div class="cl-md-12 col-lg-12 col-sm-12" style="margin-top:20px;">
            <button type="submit" id="saveButton" class="btn btn-success rounded-pill" style="width:100px">Save</button>
            <button type="reset" id="clrbtn" class="btn btn-secondary rounded-pill " style="width:100px">Clear</button>
        </div>
    </form>
</div>

<div style="margin-top:10px;/* margin-right:10px */">
    <div class="table-responsive" style="width:90%;max-height:400px;overflow-y:scroll">
        <table class="table">
            <thead class="webgrid-header" style="background-color:gray">
                <tr>
                    <th>Sr.NO</th>
                    <th id="tableId" style="display:none;">Enquiry Id</th>
                    <th>Enquiry Number</th>
                    <th>Company Name</th>
                    <th>Component Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.GridData == null)
                {
                    <tr><td colspan="5">No data available</td></tr>
                }
                else
                {
                    int i = 0;
                    @foreach (var item in ViewBag.GridData)
                    {
                        i++;
                        <tr>
                            <td>@i</td>
                            <td style="display:none;">@item.EnquiryId</td>
                            <td>@item.SalesNO</td>
                            <td>@item.CompanyName</td>
                            <td>@item.Component</td>
                            <td>
                                <a href="@Url.Action("Enquiry", "Enquiry", new { id = item.EnquiryId })">
                                    <img style="height:20px;width:20px" src="~/img/pencil.jpg" title="Edit" />
                                </a>
                                @* </td> *@
                                @* <td> *@
                                <a href="@Url.Action("Delete", "Enquiry", new { id = item.EnquiryId })">
                                    <img style="height:20px;width:20px" src="~/img/delete.png" title="Delete" />
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $('.Powder').hide();
        $('.paint').hide();
        $("#txtCarryCapacitydiv").hide();
        $("#drpConveyorNumberdiv").hide();
        $("#drpOverheadConverSubTypes").hide();      
        function toggleComponentHandling() {
            const selectedValue = $('#drpCpmonenthandling').val();
            console.log("Selected Value:", selectedValue); // Debugging log

            if (selectedValue === "1") { // Applicable
                $('#drpConveyordiv').show();              

            } else {
                $('#drpConveyordiv').hide();
                $("#drpConveyorNumberdiv").hide();
                $("#drpOverheadConverSubTypes").hide();
                $("#divPitch").hide();
                $("#divSpeed").hide();
            }
        }

        // Trigger toggle on page load and when dropdown value changes
        toggleComponentHandling(); // Check on page load
        $('#drpCpmonenthandling').change(function () {
            toggleComponentHandling(); // Check on dropdown change
        });

        $("#drpConveyor").change(function () {
            var selectedValue = $(this).val();

            // Hide all elements initially
            $("#txtCarryCapacitydiv").hide();
            $("#drpOverheadConverSubTypes").hide();
            $("#drpConveyorNumberdiv").hide();

            if (selectedValue == "3") {
                $("#drpOverheadConverSubTypes").show();
                $("#drpConveyorNumberdiv").show();
                $("#divPitch").show();
                $("#divSpeed").show();
            }
            else if (["1", "2", "6", "7", "8"].includes(selectedValue)) {
                $("#txtCarryCapacitydiv").show();
            }
        });
        $('input[name="Consumption"]').change(function () {

            if ($(this).val() == 'Paint') {

                $('.paint').show();
                $('.Powder').hide();
            } else if ($(this).val() == 'Powder') {

                $('.Powder').show();
                $('.paint').hide();
            }
        });
        $('input[name="Consumption"]').change(function () {
            var selectedValue = $(this).val();
            var $categoryDropdown = $('#Category');

            // Clear existing options
            $categoryDropdown.empty();

            // Add options based on selected radio button
            if (selectedValue === "Powder") {
                $categoryDropdown.append(new Option("Dry Paint Booth", "1"));
            } else if (selectedValue === "Paint") {
                $categoryDropdown.append(new Option("Dry Paint Booth", "1"));
                $categoryDropdown.append(new Option("Wet Paint Booth", "2"));
            }

            // Optionally reset the dropdown to default
            $categoryDropdown.val('');
        });

        $('#txtpaint').on('input', function () {
            var paintValue = parseInt($(this).val());
            if (paintValue < 20) {
                $('#Category').val('1');
            } else {
                $('#Category').val('2');
            }
        });

        $(document).ready(function () {
            $('#txtcname').on('input', function () {
                var query = $(this).val();
                if (query.length > 0) {
                    $.ajax({
                        url: '@Url.Action("SearchCompanies", "Enquiry")',
                        type: 'GET',
                        data: { term: query },
                        success: function (data) {
                            var list = $('#company-list');
                            list.empty();
                            if (data.length > 0) {
                                $.each(data, function (index, company) {
                                    list.append('<a class="dropdown-item" href="#">' + company + '</a>');
                                });
                                list.show();
                            } else {
                                list.hide();
                            }
                        },
                        error: function () {
                            console.log('Error fetching company names.');
                        }
                    });
                } else {
                    $('#company-list').hide();
                }
            });

            $(document).on('click', '.dropdown-item', function () {
                var companyName = $(this).text();
                $('#txtcname').val(companyName);
                $('#company-list').hide();

                // Fetch detailed information about the selected company
                $.ajax({
                    url: '/Enquiry/SearchByCompanyName',
                    type: 'POST',
                    datatype: 'json',
                    data: { companyName: companyName },
                    success: function (data) {
                        $("#txtcadresss").val(data.customerAddress);
                        $("#txtContactPerson").val(data.contactperson);
                        $("#txtdesignation").val(data.designation);
                        $("#txtmobile").val(data.mobileNo);
                        $("#txtemail").val(data.emailId);
                    },
                    error: function (xhr, status, error) {
                        console.error(xhr.responseText);
                    }
                });
            });

            $(document).click(function (e) {
                if (!$(e.target).closest('#txtcname, #company-list').length) {
                    $('#company-list').hide();
                }
            });

            // $('#drpShape').change(function () {
            //     var selectedShape = $(this).val();
            //     console.log("selected Shape", selectedShape);
            //     if (selectedShape == "Rectangular") {
            //         $('#rectangular-section').show();
            //         $('#circular-section').hide();
            //     } else if (selectedShape == "Circular") {
            //         $('#circular-section').show();
            //         $('#rectangular-section').hide();
            //     } else {
            //         $('#rectangular-section').hide();
            //         $('#circular-section').hide();
            //     }                
            //     $('#drpOrientation').trigger('change');
            // });

            // Orientation dropdown change event

            $('#drpShape').change(function () {
                var selectedShape = $(this).val();
                console.log("Selected Shape:", selectedShape);

                if (selectedShape == "Rectangular") {
                    $('#rectangular-section').show();
                    $('#circular-section').hide();

                    // Show Horizontal Rectangle image by default
                    $('#Horizontalrectangle').show();
                    $('#Horizontalrectangle img').attr('src', '@Url.Content("~/img/Rectangular.PNG")');
                    $('#drpOrientation').val('Horizontal').change(); // Set dropdown to Horizontal

                } else if (selectedShape == "Circular") {
                    $('#circular-section').show();
                    $('#rectangular-section').hide();
                    $('#Horizontalrectangle').hide(); // Hide rectangle image if Circular is selected
                } else {
                    $('#rectangular-section').hide();
                    $('#circular-section').hide();
                    $('#Horizontalrectangle').hide();
                }

                // Trigger change event on Orientation dropdown to update image
                $('#drpOrientation').trigger('change');
            });
            $('#drpOrientation').change(function () {
                var selectedShape = $('#drpShape').val();
                var selectedOrientation = $(this).val();

                // For rectangular shape
                if (selectedShape == "Rectangular") {
                    if (selectedOrientation == "Vertical") {
                        $('#verticalrectangle').show();
                        $('#Horizontalrectangle').hide();
                    } else {
                        $('#verticalrectangle').hide();
                        $('#Horizontalrectangle').show();
                    }
                }
                else if (selectedShape == "Circular") {
                    if (selectedOrientation == "Vertical") {
                        $('#VerticalCircle').show();
                        $('#HorizonatalCircle').hide();
                    } else {
                        $('#VerticalCircle').hide();
                        $('#HorizonatalCircle').show();
                    }
                }
            });           
            $('#drpShape').trigger('change');
        });

    });//end ready function

