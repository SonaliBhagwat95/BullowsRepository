            });





         function calculateSurfaceArea() {
            var selectedShape = $("#drpShape").val();

            if (selectedShape === "Rectangular") {
                var depth = parseFloat($("#txtLengthSize").val()) || 0;
                var width = parseFloat($("#txtWidthSize").val()) || 0;
                var height = parseFloat($("#txtHeightSize").val()) || 0;

                // Calculate surface area for a rectangular box
                var surfaceArea = 2 * (depth * width + depth * height + width * height);
                console.log("surfaceArea",surfaceArea);
                var surface= surfaceArea/1000000;
                console.log("surface",surface);

                $("#txtsurfacearea").val(surface.toFixed(2));
            }
            else if (selectedShape === "Circular") {
                var diameter = parseFloat($("#txtDiameter").val()) || 0;
                var radius = diameter / 2;
                var height = parseFloat($("#txtHeightSizeCircular").val()) || 0;

                // Calculate surface area for a circular box (2πr² + 2πrh)
                var surfaceAreaCircle = 2 * Math.PI * radius/1000 * radius/1000 ;
                var surfaceAreaCylinder = 2 * Math.PI * radius/1000 * height/1000;
                var surfaceArea = surfaceAreaCircle + surfaceAreaCylinder;
                $("#txtsurfacearea").val(surfaceArea.toFixed(2));
            }
        }
</script>




