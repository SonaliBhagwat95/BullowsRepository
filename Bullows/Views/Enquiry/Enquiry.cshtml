                    $("#manualOperationDiv").hide();
                    $("#motorisedOperationDiv").hide();
                }
            }

            // Run on page load (useful for Edit Mode)
            toggleDoorOperations();

            // Run when user changes dropdown
            $("#drpDoorType").change(function () {
