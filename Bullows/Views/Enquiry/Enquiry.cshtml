                var $dropdown = $('#drpExtractionchamberHeight');
                var $customInput = $('#txtCustomHeight');

                function updateState() {
                    if ($dropdown.val() === "custom") {
                        $customInput.show().focus();
                        $dropdown.prop('disabled', true);  // KEY: Disable dropdown so it won't post "custom"
                    } else {
                        $customInput.hide().val('');
                        $dropdown.prop('disabled', false); // Re-enable when not custom
                    }
                }

                // Run on page load (important for postbacks/validation)
                updateState();

                // Run when dropdown changes
                $dropdown.change(function () {
                    updateState();
                });




            // function ShowComponetEntry() {
            //     const selectedValue = $('#drpComponentEntry').val();
            //     const $subTypeDropdown = $('#drpComponentEntrySubType');

            //      const currentSubTypeValue = $subTypeDropdown.val(); // get existing value
            //      console.log("currentSubTypeValue",currentSubTypeValue);
