            });


            function toggleHingedOperations() {
                    var selected = $("#drpManualOperation").val();

                    if (selected === "Hinged")
                   {
                        $("#HingedDoorDiv").show();
                       
                   }
                    else
                    {
                        $("#HingedDoorDiv").hide();

                    }

            }

            // Run on page load (useful for Edit Mode)
            toggleHingedOperations();

            // Run when user changes dropdown
                $("#drpManualOperation").change(function () {
