<div style="margin-top:10px;">
    <div class="table-responsive" style="width:90%;max-height:400px;overflow-y:scroll">
        <table class="table">
            <thead class="webgrid-header" style="background-color:gray">
                <tr>
                    <th>Sr.No</th>
                    <th id="tableId" style="display:none;">Enquiry Id</th>
                    <th>Enquiry Number</th>
                    <th>Company Name</th>
                    <th>Component Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.GridData == null)
                {
                    <tr><td colspan="5">No data available</td></tr>
                }
                else
                {
                    int i = 0;
                    @foreach (var item in ViewBag.GridData)
                    {
                        i++;
                        <tr>
                            <td>@i</td>
                            <td style="display:none;">@item.EnquiryId</td>
                            <td>@item.SalesNO</td>
                            <td>@item.CompanyName</td>
                            <td>@item.Component</td>
