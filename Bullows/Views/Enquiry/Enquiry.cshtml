            //Category drp change event
            $("#Category").change(function () {
                var selectedValue = $(this).val();

                if (selectedValue == "1") {
                    $("#divSubTypeOfDraft").show();
                    $("#divDraftType").show();

                }
                else  {
                    $("#divSubTypeOfDraft").hide();
                    $("#divDraftType").hide();
                }
            });

            var allSubOptions = $("#SubtypeofDraft option").clone();

            $("#DraftType").change(function () {
                var selectedDraft = $(this).val();

                // Clear existing options and add default placeholder
                $("#SubtypeofDraft").empty().append('<option value="">--Select--</option>');

                if (selectedDraft === "1") { // Side Draft
                    // Append only the first 3 options (values 1 to 3)
                    allSubOptions.filter(function () {
                        var val = $(this).val();
                        return val === "1" || val === "2" || val === "3";
                    }).appendTo("#SubtypeofDraft");
                }
                else if (selectedDraft === "2") { // Down Draft

                    allSubOptions.filter(function () {
                        var val = $(this).val();
                        return val === "4" || val === "5" || val === "6" || val === "7";
                    }).appendTo("#SubtypeofDraft");
                }
                else if (selectedDraft === "3") { //Semi Down Draft

                    allSubOptions.filter(function () {
                        var val = $(this).val();
                        return val === "8" || val === "9";
                    }).appendTo("#SubtypeofDraft");
                }

            });
            //code for when Painbooth type is open then hide component entry div
            function toggleComponentEntryVisibility() {
                var selectedValue = $('#SubtypeofDraft').val();
                if (selectedValue === "1") {
                    $('#DivComponentEntryAndDoorTypes').hide();
                }
                else {
                    $('#DivComponentEntryAndDoorTypes').show();
                }
                if(selectedValue === "3")
                {
                    $('#divPlenumHeight').show();
                }
                 else {
                       $('#divPlenumHeight').hide();
