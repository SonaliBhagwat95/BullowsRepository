        //company details fetch code
            $(document).ready(function () {
                $('#txtcname').on('input', function () {
                    var query = $(this).val();
                    if (query.length > 0) {
                        $.ajax({
                            url: '@Url.Action("SearchCompanies", "Enquiry")',
                            type: 'GET',
                            data: { term: query },
                            success: function (data) {
                                var list = $('#company-list');
                                list.empty();
                                if (data.length > 0) {
                                    $.each(data, function (index, company) {
                                        list.append('<a class="dropdown-item" href="#">' + company + '</a>');
                                    });
                                    list.show();
                                } else {
                                    list.hide();
                                }
                            },
                            error: function () {
                                console.log('Error fetching company names.');
                            }
                        });
                    } else {
                        $('#company-list').hide();
                    }
                });

                $(document).on('click', '.dropdown-item', function () {
                    var companyName = $(this).text();
                    $('#txtcname').val(companyName);
                    $('#company-list').hide();

                    // Fetch detailed information about the selected company
                    $.ajax({
                        url: '/Enquiry/SearchByCompanyName',
                        type: 'POST',
                        datatype: 'json',
                        data: { companyName: companyName },
                        success: function (data) {
                            $("#txtcadresss").val(data.customerAddress);
                            $("#txtContactPerson").val(data.contactperson);
                            $("#txtdesignation").val(data.designation);
                            $("#txtmobile").val(data.mobileNo);
                            $("#txtemail").val(data.emailId);
                        },
                        error: function (xhr, status, error) {
                            console.error(xhr.responseText);
                        }
                    });
                });

                $(document).click(function (e) {
                    if (!$(e.target).closest('#txtcname, #company-list').length) {
                        $('#company-list').hide();
                    }
                });

                $('#drpShape').change(function () {
                    var selectedShape = $(this).val();
                    console.log("Selected Shape:", selectedShape);

                    if (selectedShape == "Rectangular") {
                        $('#rectangular-section').show();
                        $('#circular-section').hide();

                        // Show Horizontal Rectangle image by default
                        $('#Horizontalrectangle').show();
                        $('#Horizontalrectangle img').attr('src', '@Url.Content("~/img/Rectangular.PNG")');
                      /*   $('#drpOrientation').val('Horizontal').change(); */ // Set dropdown to Horizontal
                          // Only set default Horizontal if dropdown has no value (new entry case)
                        if (!$('#drpOrientation').val()) {
                            $('#drpOrientation').val('Horizontal').change();
                        }

                    } else if (selectedShape == "Circular") {
                        $('#circular-section').show();
                        $('#rectangular-section').hide();
                        $('#Horizontalrectangle').hide(); // Hide rectangle image if Circular is selected
                    } else {
                        $('#rectangular-section').hide();
                        $('#circular-section').hide();
                        $('#Horizontalrectangle').hide();
                    }

                    // Trigger change event on Orientation dropdown to update image
                    $('#drpOrientation').trigger('change');
                });
                //dropdown orientation change
                $('#drpOrientation').change(function () {
                    var selectedShape = $('#drpShape').val();
                    var selectedOrientation = $(this).val();

                    // For rectangular shape
                    if (selectedShape == "Rectangular") {
                        if (selectedOrientation == "Vertical") {
                            $('#verticalrectangle').show();
                            $('#Horizontalrectangle').hide();
                        } else {
                            $('#verticalrectangle').hide();
                            $('#Horizontalrectangle').show();
                        }
                    }
                    else if (selectedShape == "Circular") {
                        if (selectedOrientation == "Vertical") {
                            $('#VerticalCircle').show();
                            $('#HorizonatalCircle').hide();
                        } else {
                            $('#VerticalCircle').hide();
                            $('#HorizonatalCircle').show();
                        }
                    }
                });
                $('#drpShape').trigger('change');
            });

        });
        let uploadedFiles = [];

        // Handle file uploads
        function handleFileUpload() {
            const fileInput = $('#imageFileInput')[0];
            const newFiles = Array.from(fileInput.files);

            // Append new files to the existing array
            uploadedFiles = uploadedFiles.concat(newFiles);

            // Enable the "Show Uploaded Files" button if there are uploaded files
            $('#showFilesButton').prop('disabled', uploadedFiles.length === 0);

            // Show the uploaded files in the modal
            showUploadedFiles();
        }

        // Show uploaded files in the modal
        function showUploadedFiles() {
            const fileList = $('#uploadedFilesList');
            fileList.empty(); // Clear the existing list

            $.each(uploadedFiles, function (index, file) {
                const listItem = $('<li></li>');

                // Create a link for the file name that enables download
                const fileLink = $('<a></a>')
                    .attr('href', URL.createObjectURL(file))
                    .attr('download', file.name)
                    .text(file.name);

                listItem.append(fileLink);
                fileList.append(listItem);
            });
        }

        // Download all uploaded files
        function downloadAllFiles() {
            $.each(uploadedFiles, function (index, file) {
                const url = URL.createObjectURL(file);
                const a = $('<a></a>')
                    .attr('href', url)
                    .attr('download', file.name);
                $('body').append(a);
                a[0].click();
                a.remove();
            });
        }

        function toggleDropdowns() {
                var val = $("input[name='Consumption']:checked").val();

                if (val === "Paint") {
                    $("#paintDiv").show();
                    $("#powderDiv").hide();
                }
                else if (val === "Powder") {
                    $("#powderDiv").show();
                    $("#paintDiv").hide();
                }
            }

            // Run on page load (works in edit mode)
            toggleDropdowns();

            // Run when user changes radio button
            $("input[name='Consumption']").change(function () {
                toggleDropdowns();
            });

    function toggleDoorOperations() {
                var selected = $("#drpDoorType").val();

                if (selected === "Manual") {
                    $("#manualOperationDiv").show();
                    $("#motorisedOperationDiv").hide();
                }
                else if (selected === "Motorised") {
                    $("#manualOperationDiv").hide();
